model WorkflowTaskExecutionSession {
  id                      String                             @id @default(cuid())
  workflowTaskId          String                             @map("workflow_task_id")
  assignmentId            String?                            @map("assignment_id")
  operatorId              String                             @map("operator_id")
  departmentId            String                             @map("department_id")
  status                  WorkflowTaskExecutionSessionStatus @default(IN_PROGRESS)
  startedAt               DateTime                           @default(now()) @map("started_at")
  pausedAt                DateTime?                          @map("paused_at")
  resumedAt               DateTime?                          @map("resumed_at")
  completedAt             DateTime?                          @map("completed_at")
  workingDurationSeconds  Int                                @default(0) @map("working_duration_seconds")
  pausedDurationSeconds   Int                                @default(0) @map("paused_duration_seconds")
  holdDurationSeconds     Int                                @default(0) @map("hold_duration_seconds")
  totalDurationSeconds    Int                                @default(0) @map("total_duration_seconds")
  activeIntervalStartedAt DateTime?                          @map("active_interval_started_at")
  activeIntervalType      WorkflowTaskExecutionIntervalType? @map("active_interval_type")
  createdAt               DateTime                           @default(now()) @map("created_at")
  updatedAt               DateTime                           @updatedAt @map("updated_at")

