// ─────────────────────────────────────────────────────────────────────────────
// Auth & Users
// ─────────────────────────────────────────────────────────────────────────────

model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  displayName String   @map("display_name")
  description String?
  permissions Json     @default("[]")
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("roles")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  firstName    String     @map("first_name")
  lastName     String     @map("last_name")
  phone        String?    @unique
  avatarUrl    String?    @map("avatar_url")
  status       UserStatus @default(PENDING_VERIFICATION)
  roleId       String     @map("role_id")
  lastLoginAt  DateTime?  @map("last_login_at")
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  role               Role               @relation(fields: [roleId], references: [id])
  refreshTokens      RefreshToken[]
  orders             Order[]
  wallet             Wallet?
  walletTransactions WalletTransaction[]
  payments           Payment[]
  financialAuditsAsTarget FinancialAuditLog[] @relation("FinancialAuditTarget")
  financialAuditsAsActor  FinancialAuditLog[] @relation("FinancialAuditActor")
  walletTransactionsCreated WalletTransaction[] @relation("WalletTransactionCreatedBy")
  vendorProfile      VendorProfile?
  vendorsVerified    VendorProfile[]    @relation("VendorVerifiedBy")
  vendorsRejected    VendorProfile[]    @relation("VendorRejectedBy")
  adminNotes         AdminNote[]        @relation("AdminNoteAuthor")
  activityLogs       ActivityLog[]      @relation("ActivityActor")
  sliderSlidesCreated SliderSlide[]     @relation("SliderSlideCreatedBy")
  sliderSlidesUpdated SliderSlide[]     @relation("SliderSlideUpdatedBy")
  assignedContactInquiries ContactInquiry[] @relation("ContactInquiryAssignee")
  resolvedContactInquiries ContactInquiry[] @relation("ContactInquiryResolver")
  contactInquiryNotes      ContactInquiryNote[]
  contactInquiryActivities ContactInquiryActivity[]
  uploadedFileAssets       FileAsset[]
  productionOrders         ProductionOrder[]
  assignedWorkflowTasks    WorkflowTask[]           @relation("WorkflowTaskAssignee")
  workflowTaskHistory      WorkflowTaskHistory[]    @relation("WorkflowTaskHistoryPerformer")
  reworkRequestsCreated    ReworkRequest[]          @relation("ReworkRequestCreator")
  quotes                   Quote[]
  auditLogs                AuditLog[]
  vendorComplianceCreated  VendorComplianceRequest[] @relation("VendorComplianceCreatedBy")
  vendorComplianceReviewed VendorComplianceRequest[] @relation("VendorComplianceReviewedBy")
  vendorComplianceItemReviewed VendorComplianceResponse[] @relation("VendorComplianceResponseReviewedBy")
  deliverySettingsUpdated      DeliverySettings[]          @relation("DeliverySettingsUpdatedBy")

  @@index([roleId])
  @@index([status])
  @@index([phone])
  @@index([deletedAt])
  @@map("users")
}

model VendorCodeSequence {
  id        Int @id @default(1)
  lastValue Int @default(1000) @map("last_value")

  @@map("vendor_code_sequences")
}

model VendorProfile {
  id                  String              @id @default(cuid())
  vendorCode          String              @unique @map("vendor_code")
  userId              String              @unique @map("user_id")
  businessName        String              @map("business_name")
  ownerName           String              @map("owner_name")
  alternatePhone      String?             @map("alternate_phone")
  gstNumber           String?             @map("gst_number")
  referenceCode       String?             @map("reference_code")
  employeeCode        String?             @map("employee_code")
  country             String              @default("India")
  state               String?
  district            String?
  city                String?
  pinCode             String              @map("pin_code")
  fullAddress         String              @map("full_address") @db.Text
  businessType        String?             @map("business_type")
  services            Json                @default("[]")
  accountStatus       VendorAccountStatus @default(PENDING) @map("account_status")
  deliveryPreference  DeliveryPreference  @default(ASK_ON_EVERY_ORDER) @map("delivery_preference")
  verificationRemarks String?             @map("verification_remarks") @db.Text
  verifiedAt          DateTime?           @map("verified_at")
  verifiedById        String?             @map("verified_by_id")
  rejectedAt          DateTime?           @map("rejected_at")
  rejectedById        String?             @map("rejected_by_id")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy User? @relation("VendorVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  rejectedBy User? @relation("VendorRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  adminNotes         AdminNote[]
  activities         ActivityLog[]              @relation("VendorActivity")
  complianceRequests VendorComplianceRequest[]
  complianceResponses VendorComplianceResponse[]

  @@index([accountStatus])
  @@index([deliveryPreference])
  @@index([businessName])
  @@index([vendorCode])
  @@index([createdAt])
  @@map("vendor_profiles")
}

/// Platform-wide delivery configuration (singleton row id = "default")
model DeliverySettings {
  id                    String   @id @default("default")
  defaultDeliveryCharge Decimal  @default(100) @map("default_delivery_charge") @db.Decimal(12, 2)
  isDeliveryEnabled     Boolean  @default(true) @map("is_delivery_enabled")
  isPickupEnabled       Boolean  @default(true) @map("is_pickup_enabled")
  /// Future: zone pricing, courier providers, free-delivery rules, weight tiers
  futureConfig          Json     @default("{}") @map("future_config")
  updatedById           String?  @map("updated_by_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation("DeliverySettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("delivery_settings")
}

// =====================================================
// VENDOR COMPLIANCE — dynamic document & question requests from admin
// Flow: Admin creates request → Vendor submits on status page → Admin reviews
// =====================================================

model VendorComplianceRequest {
  id              String                        @id @default(cuid())
  vendorProfileId String                        @map("vendor_profile_id")
  referenceCode   String                        @unique @map("reference_code")
  title           String?
  instructions    String?                       @db.Text
  status          VendorComplianceRequestStatus @default(DRAFT)
  dueAt           DateTime?                     @map("due_at")
  createdById     String                        @map("created_by_id")
  sentAt          DateTime?                     @map("sent_at")
  submittedAt     DateTime?                     @map("submitted_at")
  reviewedAt      DateTime?                     @map("reviewed_at")
  reviewedById    String?                       @map("reviewed_by_id")
  cancelledAt     DateTime?                     @map("cancelled_at")
  createdAt       DateTime                      @default(now()) @map("created_at")
  updatedAt       DateTime                      @updatedAt @map("updated_at")

  vendorProfile VendorProfile                 @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  createdBy     User                          @relation("VendorComplianceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy    User?                         @relation("VendorComplianceReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  items         VendorComplianceRequestItem[]

  @@index([vendorProfileId])
  @@index([status])
  @@index([createdAt])
  @@map("vendor_compliance_requests")
}

model VendorComplianceRequestItem {
  id                 String                 @id @default(cuid())
  requestId          String                 @map("request_id")
  itemType           VendorComplianceItemType @map("item_type")
  code               String?
  label              String
  description        String?                @db.Text
  isRequired         Boolean                @default(true) @map("is_required")
  sortOrder          Int                    @default(0) @map("sort_order")
  maxFileSizeMb      Int?                   @map("max_file_size_mb")
  acceptedFileTypes  Json                   @default("[]") @map("accepted_file_types")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  request   VendorComplianceRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  responses VendorComplianceResponse[]

  @@index([requestId])
  @@index([itemType])
  @@map("vendor_compliance_request_items")
}

model VendorComplianceResponse {
  id              String                         @id @default(cuid())
  requestItemId   String                         @map("request_item_id")
  vendorProfileId String                         @map("vendor_profile_id")
  textAnswer      String?                        @map("text_answer") @db.Text
  fileAssetId     String?                        @map("file_asset_id")
  status          VendorComplianceResponseStatus @default(SUBMITTED)
  adminRemarks    String?                        @map("admin_remarks") @db.Text
  reviewedById    String?                        @map("reviewed_by_id")
  reviewedAt      DateTime?                      @map("reviewed_at")
  submittedAt     DateTime                       @default(now()) @map("submitted_at")
  createdAt       DateTime                       @default(now()) @map("created_at")
  updatedAt       DateTime                       @updatedAt @map("updated_at")

  requestItem   VendorComplianceRequestItem @relation(fields: [requestItemId], references: [id], onDelete: Cascade)
  vendorProfile VendorProfile               @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  fileAsset     FileAsset?                  @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)
  reviewedBy    User?                       @relation("VendorComplianceResponseReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([requestItemId, vendorProfileId])
  @@index([vendorProfileId])
  @@index([fileAssetId])
  @@index([status])
  @@map("vendor_compliance_responses")
}

model AdminNote {
  id              String   @id @default(cuid())
  vendorProfileId String   @map("vendor_profile_id")
  authorId        String   @map("author_id")
  content         String   @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  vendorProfile VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  author        User          @relation("AdminNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([vendorProfileId])
  @@index([authorId])
  @@index([createdAt])
  @@map("admin_notes")
}

model ActivityLog {
  id              String         @id @default(cuid())
  action          ActivityAction
  entityType      String         @map("entity_type")
  entityId        String         @map("entity_id")
  vendorProfileId String?        @map("vendor_profile_id")
  actorId         String?        @map("actor_id")
  metadata        Json           @default("{}")
  ipAddress       String?        @map("ip_address")
  userAgent       String?        @map("user_agent") @db.Text
  createdAt       DateTime       @default(now()) @map("created_at")

  vendorProfile VendorProfile? @relation("VendorActivity", fields: [vendorProfileId], references: [id], onDelete: Cascade)
  actor         User?          @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([vendorProfileId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// =====================================================
// PRODUCT ENGINE — PHASE 1 (Printing ERP Foundation)
// Category → ProductFamily → ProductSeries → ProductOffering → ProductOfferingVersion
//
// VERSIONING RULE: All sellable definition (config, pricing, files, workflow, BOM)
// attaches to ProductOfferingVersion — never to ProductOffering directly.
// ProductOffering is the stable catalog identity; versions are immutable snapshots.
// =====================================================

model Category {
  id          String    @id @default(cuid())
  parentId    String?   @map("parent_id")
  name        String
  slug        String    @unique
  description String?   @db.Text
  imageUrl    String?   @map("image_url")
  imageKey    String?   @map("image_key")
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  parent          Category?       @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children        Category[]      @relation("CategoryHierarchy")
  productFamilies ProductFamily[]

  @@index([parentId])
  @@index([isActive, deletedAt])
  @@index([sortOrder])
  @@map("categories")
}

/// Material / substrate under a category — e.g. "800 GSM Cards", "Metal Cards".
model ProductFamily {
  id          String        @id @default(cuid())
  categoryId  String        @map("category_id")
  name        String
  slug        String        @unique
  description String?       @db.Text
  sortOrder   Int           @default(0) @map("sort_order")
  status      ProductStatus @default(ACTIVE)
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  category Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  series   ProductSeries[]

  @@index([categoryId])
  @@index([status])
  @@index([isActive, deletedAt])
  @@map("product_families")
}

/// Base finish within a family — e.g. "800 GSM + Matt", "800 GSM + Velvet".
model ProductSeries {
  id             String        @id @default(cuid())
  familyId       String        @map("family_id")
  name           String
  slug           String        @unique
  description    String?       @db.Text
  productCode    String?       @unique @map("product_code")
  productionDays Int?          @map("production_days")
  notes          String?       @db.Text
  sortOrder      Int           @default(0) @map("sort_order")
  status         ProductStatus @default(ACTIVE)
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  family    ProductFamily     @relation(fields: [familyId], references: [id], onDelete: Restrict)
  offerings ProductOffering[]

  @@index([familyId])
  @@index([productCode])
  @@index([status])
  @@index([isActive, deletedAt])
  @@map("product_series")
}

/// Sellable finish combination — e.g. "800 GSM + Matt + UV + Foil + Die Cut".
/// Identity and merchandising only; all definition lives on ProductOfferingVersion.
model ProductOffering {
  id               String             @id @default(cuid())
  seriesId         String             @map("series_id")
  name             String
  slug             String             @unique
  shortDescription String?            @map("short_description")
  description      String?            @db.Text
  sku              String?            @unique
  displayName      String?            @map("display_name")
  thumbnailUrl     String?            @map("thumbnail_url")
  thumbnailKey     String?            @map("thumbnail_key")
  visibility       ProductVisibility  @default(VENDOR_ONLY)
  sortOrder        Int                @default(0) @map("sort_order")
  status           ProductStatus      @default(DRAFT)
  isFeatured       Boolean            @default(false) @map("is_featured")
  isActive         Boolean            @default(true) @map("is_active")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  deletedAt        DateTime?          @map("deleted_at")

  series   ProductSeries            @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  versions ProductOfferingVersion[]
  images   ProductImage[]

  @@index([seriesId])
  @@index([sku])
  @@index([status])
  @@index([visibility])
  @@index([isActive, deletedAt])
  @@map("product_offerings")
}

/// Gallery / marketing images stored in Cloudflare R2
model ProductImage {
  id                String   @id @default(cuid())
  productOfferingId String   @map("product_offering_id")
  imageUrl          String   @map("image_url") @db.Text
  imageKey          String   @map("image_key")
  altText           String?  @map("alt_text")
  sortOrder         Int      @default(0) @map("sort_order")
  isThumbnail       Boolean  @default(false) @map("is_thumbnail")
  createdAt         DateTime @default(now()) @map("created_at")

  productOffering ProductOffering @relation(fields: [productOfferingId], references: [id], onDelete: Cascade)

  @@index([productOfferingId])
  @@index([sortOrder])
  @@map("product_images")
}

/// Immutable versioned snapshot — source of truth for config, pricing, files, workflow, BOM.
/// Quotes, orders, and production jobs must pin a specific version at creation time.
model ProductOfferingVersion {
  id                  String                       @id @default(cuid())
  productOfferingId   String                       @map("product_offering_id")
  versionNumber       Int                          @map("version_number")
  versionLabel        String                       @map("version_label")
  status              ProductOfferingVersionStatus @default(DRAFT)
  effectiveFrom       DateTime                     @default(now()) @map("effective_from")
  effectiveTo         DateTime?                    @map("effective_to")
  isCurrent           Boolean                      @default(false) @map("is_current")
  changelog           String?                      @db.Text
  pricingProfileKey   String?                      @map("pricing_profile_key")
  workflowKey         String?                      @map("workflow_key")
  /// Denormalized publish cache — relational models are authoritative.
  configurationSchema Json                         @default("{}") @map("configuration_schema")
  fileRequirements    Json                         @default("{}") @map("file_requirements")
  metadata            Json                         @default("{}")
  publishedAt         DateTime?                    @map("published_at")
  createdAt           DateTime                     @default(now()) @map("created_at")
  updatedAt           DateTime                     @updatedAt @map("updated_at")
  deletedAt           DateTime?                    @map("deleted_at")

  productOffering       ProductOffering         @relation(fields: [productOfferingId], references: [id], onDelete: Restrict)
  configurationGroups   ConfigurationGroup[]
  configurationFields   ConfigurationField[]
  configurationRules    ConfigurationRule[]
  quantityPricing       QuantityPricing[]
  pricingRules          PricingRule[]
  fileRequirementsRel   FileRequirement[]
  workflow              ProductOfferingWorkflow?
  bomTemplate           BomTemplate?
  orderItems            OrderItem[]
  productionOrderItems  ProductionOrderItem[]
  quoteItems            QuoteItem[]

  @@unique([productOfferingId, versionNumber])
  @@index([productOfferingId, status, deletedAt])
  @@index([productOfferingId, isCurrent])
  @@index([effectiveFrom, effectiveTo])
  @@map("product_offering_versions")
}

// =====================================================
// PRODUCT ENGINE — PHASE 2 (Configuration Engine)
// Dynamic order-time fields, options, and dependency rules per ProductOfferingVersion.
// =====================================================

model ConfigurationGroup {
  id                       String   @id @default(cuid())
  productOfferingVersionId String   @map("product_offering_version_id")
  name                     String
  code                     String
  description              String?  @db.Text
  sortOrder                Int      @default(0) @map("sort_order")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  productOfferingVersion ProductOfferingVersion @relation(fields: [productOfferingVersionId], references: [id], onDelete: Cascade)
  fields                 ConfigurationField[]

  @@unique([productOfferingVersionId, code])
  @@index([productOfferingVersionId])
  @@map("configuration_groups")
}

model ConfigurationField {
  id                       String                 @id @default(cuid())
  productOfferingVersionId String                 @map("product_offering_version_id")
  groupId                  String?                @map("group_id")
  code                     String
  label                    String
  description              String?                @db.Text
  fieldType                ConfigurationFieldType @map("field_type")
  placeholder              String?
  isRequired               Boolean                @default(false) @map("is_required")
  isVisible                Boolean                @default(true) @map("is_visible")
  sortOrder                Int                    @default(0) @map("sort_order")
  createdAt                DateTime               @default(now()) @map("created_at")
  updatedAt                DateTime               @updatedAt @map("updated_at")

  productOfferingVersion ProductOfferingVersion @relation(fields: [productOfferingVersionId], references: [id], onDelete: Cascade)
  group                  ConfigurationGroup?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  options                ConfigurationOption[]
  targetRules            ConfigurationRule[]
  pricingRules           PricingRule[]

  @@unique([productOfferingVersionId, code])
  @@index([productOfferingVersionId])
  @@index([groupId])
  @@map("configuration_fields")
}

model ConfigurationOption {
  id          String   @id @default(cuid())
  fieldId     String   @map("field_id")
  label       String
  value       String
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isDefault   Boolean  @default(false) @map("is_default")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  field        ConfigurationField           @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  pricing      ConfigurationOptionPricing?
  pricingRules PricingRule[]

  @@unique([fieldId, value])
  @@index([fieldId])
  @@map("configuration_options")
}

/// JSON condition engine — supports AND/OR nesting and future custom operators.
/// Example: { "and": [{ "field": "foil", "operator": "!=", "value": "not_required" }] }
model ConfigurationRule {
  id                       String                @id @default(cuid())
  productOfferingVersionId String                @map("product_offering_version_id")
  targetFieldId            String                @map("target_field_id")
  ruleType                 ConfigurationRuleType @map("rule_type")
  condition                Json
  sortOrder                Int                   @default(0) @map("sort_order")
  createdAt                DateTime              @default(now()) @map("created_at")
  updatedAt                DateTime              @updatedAt @map("updated_at")

  productOfferingVersion ProductOfferingVersion @relation(fields: [productOfferingVersionId], references: [id], onDelete: Cascade)
  targetField            ConfigurationField     @relation(fields: [targetFieldId], references: [id], onDelete: Cascade)

  @@index([productOfferingVersionId])
  @@index([targetFieldId])
  @@map("configuration_rules")
}

// =====================================================
// PRODUCT ENGINE — PHASE 3 (Pricing Engine)
// Quantity tiers, option adjustments, advanced rules, and immutable price snapshots.
// =====================================================

model QuantityPricing {
  id                       String   @id @default(cuid())
  productOfferingVersionId String   @map("product_offering_version_id")
  quantity                 Int
  basePrice                Decimal  @map("base_price") @db.Decimal(12, 2)
  isActive                 Boolean  @default(true) @map("is_active")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  productOfferingVersion ProductOfferingVersion @relation(fields: [productOfferingVersionId], references: [id], onDelete: Cascade)

  @@unique([productOfferingVersionId, quantity])
  @@index([productOfferingVersionId])
  @@map("quantity_pricing")
}

model ConfigurationOptionPricing {
  id              String                @id @default(cuid())
  optionId        String                @unique @map("option_id")
  adjustmentType  PricingAdjustmentType @map("adjustment_type")
  adjustmentValue Decimal               @map("adjustment_value") @db.Decimal(12, 2)
  isActive        Boolean               @default(true) @map("is_active")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  option ConfigurationOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@index([optionId])
  @@map("configuration_option_pricing")
}

model PricingRule {
  id                       String                @id @default(cuid())
  productOfferingVersionId String                @map("product_offering_version_id")
  configurationFieldId     String?               @map("configuration_field_id")
  configurationOptionId    String?               @map("configuration_option_id")
  name                     String
  description              String?               @db.Text
  condition                Json                  @default("{}")
  adjustmentType           PricingAdjustmentType @map("adjustment_type")
  adjustmentValue          Decimal               @map("adjustment_value") @db.Decimal(12, 2)
  priority                 Int                   @default(0)
  status                   PricingRuleStatus     @default(ACTIVE)
  createdAt                DateTime              @default(now()) @map("created_at")
  updatedAt                DateTime              @updatedAt @map("updated_at")

  productOfferingVersion ProductOfferingVersion @relation(fields: [productOfferingVersionId], references: [id], onDelete: Cascade)
  configurationField     ConfigurationField?    @relation(fields: [configurationFieldId], references: [id], onDelete: SetNull)
  configurationOption    ConfigurationOption?   @relation(fields: [configurationOptionId], references: [id], onDelete: SetNull)

  @@index([productOfferingVersionId])
  @@index([configurationFieldId])
  @@index([configurationOptionId])
  @@index([status])
  @@index([priority])
  @@map("pricing_rules")
}

/// Immutable breakdown stored when an order/quote is priced — protects historical totals.
model PriceSnapshot {
  id              String   @id @default(cuid())
  subtotal        Decimal  @db.Decimal(12, 2)
  adjustmentTotal Decimal @map("adjustment_total") @db.Decimal(12, 2)
  discountTotal   Decimal @map("discount_total") @db.Decimal(12, 2)
  taxTotal        Decimal @map("tax_total") @db.Decimal(12, 2)
  grandTotal      Decimal @map("grand_total") @db.Decimal(12, 2)
  calculation     Json
  createdAt       DateTime @default(now()) @map("created_at")

  orderItems           OrderItem[]
  productionOrderItems ProductionOrderItem[]
  quoteItems           QuoteItem[]

  @@map("price_snapshots")
}

// =====================================================
// PRODUCT ENGINE — PHASE 4 (File Requirement Engine)
// Cloudflare R2 compatible — metadata in DB, blobs in object storage.
// =====================================================

model FileRequirement {
  id                       String              @id @default(cuid())
  productOfferingVersionId String              @map("product_offering_version_id")
  code                     String
  label                    String
  description              String?             @db.Text
  requirementType          FileRequirementType @map("requirement_type")
  maxFileSizeMb            Int?                @map("max_file_size_mb")
  allowMultiple            Boolean             @default(false) @map("allow_multiple")
  sortOrder                Int                 @default(0) @map("sort_order")
  createdAt                DateTime            @default(now()) @map("created_at")
  updatedAt                DateTime            @updatedAt @map("updated_at")

  productOfferingVersion ProductOfferingVersion    @relation(fields: [productOfferingVersionId], references: [id], onDelete: Cascade)
  allowedFileTypes       FileRequirementFileType[]

  @@unique([productOfferingVersionId, code])
  @@index([productOfferingVersionId])
  @@map("file_requirements")
}

model FileRequirementFileType {
  id            String            @id @default(cuid())
  requirementId String            @map("requirement_id")
  fileType      SupportedFileType @map("file_type")

  requirement FileRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([requirementId, fileType])
  @@index([requirementId])
  @@map("file_requirement_file_types")
}

/// File metadata — bytes in Cloudflare R2 (`fileKey`). `fileUrl` is legacy/public only for marketing assets; vendor docs use presigned access.
model FileAsset {
  id           String   @id @default(cuid())
  originalName String   @map("original_name")
  fileName     String   @map("file_name")
  fileKey      String   @unique @map("file_key")
  fileUrl      String   @map("file_url") @db.Text
  mimeType     String   @map("mime_type")
  extension    String
  fileSize     Int      @map("file_size")
  uploadedById String?  @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  uploadedBy          User?                        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  orderItemFiles      OrderItemFile[]
  complianceResponses VendorComplianceResponse[]

  @@index([uploadedById])
  @@index([createdAt])
  @@map("file_assets")
}

// =====================================================
// PRODUCT ENGINE — PHASE 5 (Workflow Engine)
// Printing ERP production workflow — templates, facilities, SLA.
// =====================================================

model Facility {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String?  @db.Text
  phone     String?
  email     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  departments       Department[]
  workflowTemplates WorkflowTemplate[]
  machines          Machine[]

  @@map("facilities")
}

model Department {
  id          String   @id @default(cuid())
  facilityId  String   @map("facility_id")
  name        String
  code        String   @unique
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  facility              Facility               @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  workflowSteps         WorkflowTemplateStep[]
  workflowTasks         WorkflowTask[]         @relation("WorkflowTaskStepDepartment")
  assignedWorkflowTasks WorkflowTask[]         @relation("WorkflowTaskAssignedDepartment")
  machines              Machine[]

  @@index([facilityId])
  @@map("departments")
}

model WorkflowTemplate {
  id          String         @id @default(cuid())
  facilityId  String         @map("facility_id")
  name        String
  code        String         @unique
  description String?        @db.Text
  status      WorkflowStatus @default(ACTIVE)
  isDefault   Boolean        @default(false) @map("is_default")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  facility                  Facility                  @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  steps                     WorkflowTemplateStep[]
  productOfferingWorkflows  ProductOfferingWorkflow[]
  workflowInstances         WorkflowInstance[]

  @@index([facilityId])
  @@map("workflow_templates")
}

model WorkflowTemplateStep {
  id                 String           @id @default(cuid())
  workflowTemplateId String           @map("workflow_template_id")
  departmentId       String           @map("department_id")
  stepName           String           @map("step_name")
  stepCode           String           @map("step_code")
  stepType           WorkflowStepType @map("step_type")
  stepOrder          Int              @map("step_order")
  expectedMinutes    Int              @map("expected_minutes")
  allowRework        Boolean          @default(true) @map("allow_rework")
  allowSkip          Boolean          @default(false) @map("allow_skip")
  isMandatory        Boolean          @default(true) @map("is_mandatory")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  workflowTemplate WorkflowTemplate   @relation(fields: [workflowTemplateId], references: [id], onDelete: Cascade)
  department       Department         @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  slaPolicy        WorkflowSlaPolicy?
  workflowTasks    WorkflowTask[]

  @@unique([workflowTemplateId, stepOrder])
  @@index([workflowTemplateId])
  @@index([departmentId])
  @@map("workflow_template_steps")
}

/// Links a product offering version to its production workflow template (one per version).
model ProductOfferingWorkflow {
  id                       String   @id @default(cuid())
  productOfferingVersionId String   @unique @map("product_offering_version_id")
  workflowTemplateId       String   @map("workflow_template_id")
  isDefault                Boolean  @default(true) @map("is_default")
  createdAt                DateTime @default(now()) @map("created_at")

  productOfferingVersion ProductOfferingVersion @relation(fields: [productOfferingVersionId], references: [id], onDelete: Cascade)
  workflowTemplate       WorkflowTemplate       @relation(fields: [workflowTemplateId], references: [id], onDelete: Restrict)

  @@index([workflowTemplateId])
  @@map("product_offering_workflows")
}

model Machine {
  id           String        @id @default(cuid())
  facilityId   String        @map("facility_id")
  departmentId String        @map("department_id")
  machineCode  String        @unique @map("machine_code")
  machineName  String        @map("machine_name")
  status       MachineStatus @default(ACTIVE)
  metadata     Json          @default("{}")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  facility       Facility       @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  department     Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  assignedTasks  WorkflowTask[]

  @@index([facilityId])
  @@index([departmentId])
  @@index([status])
  @@map("machines")
}

model WorkflowSlaPolicy {
  id                     String   @id @default(cuid())
  workflowTemplateStepId String   @unique @map("workflow_template_step_id")
  warningAfterMinutes    Int      @map("warning_after_minutes")
  criticalAfterMinutes   Int      @map("critical_after_minutes")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  workflowTemplateStep WorkflowTemplateStep @relation(fields: [workflowTemplateStepId], references: [id], onDelete: Cascade)

  @@map("workflow_sla_policies")
}

// =====================================================
// PRODUCT ENGINE — PHASE 6 (Order + Workflow Execution)
// Production orders, item snapshots, and runtime workflow tasks.
//
// ORDER STRATEGY:
// - ProductionOrder = primary ERP business order (config, pricing, workflow pinned).
// - Order (below) = legacy checkout/wallet layer — retained until unified migration.
// Future: Order.productionOrderId or wallet → ProductionOrder bridge.
// =====================================================

model ProductionOrder {
  id          String                @id @default(cuid())
  orderNumber String                @unique @map("order_number")
  customerId  String                @map("customer_id")
  orderName   String?               @map("order_name")
  status      ProductionOrderStatus @default(CONFIRMED)
  subtotal        Decimal               @db.Decimal(12, 2)
  deliveryCharge  Decimal               @default(0) @map("delivery_charge") @db.Decimal(12, 2)
  taxAmount       Decimal               @map("tax_amount") @db.Decimal(12, 2)
  totalAmount     Decimal               @map("total_amount") @db.Decimal(12, 2)
  deliveryRequired Boolean              @default(false) @map("delivery_required")
  deliveryType    DeliveryType?         @map("delivery_type")
  deliveryAddress String?               @map("delivery_address") @db.Text
  deliveryStatus  DeliveryStatus?       @map("delivery_status")
  notes           String?               @db.Text
  quoteId         String?               @map("quote_id")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  customer          User                  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quote             Quote?                @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  items             ProductionOrderItem[]
  workflowInstances WorkflowInstance[]
  jobCards          ProductionJobCard[]

  @@index([customerId])
  @@index([quoteId])
  @@index([status])
  @@index([orderNumber])
  @@map("production_orders")
}

model ProductionOrderItem {
  id                       String   @id @default(cuid())
  orderId                  String   @map("order_id")
  productOfferingVersionId String   @map("product_offering_version_id")
  quantity                 Int
  unitPrice                Decimal  @map("unit_price") @db.Decimal(12, 2)
  totalPrice               Decimal  @map("total_price") @db.Decimal(12, 2)
  priceSnapshotId          String?  @map("price_snapshot_id")
  createdAt                DateTime @default(now()) @map("created_at")

  order                  ProductionOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productOfferingVersion ProductOfferingVersion   @relation(fields: [productOfferingVersionId], references: [id], onDelete: Restrict)
  priceSnapshot          PriceSnapshot?           @relation(fields: [priceSnapshotId], references: [id], onDelete: Restrict)
  configurations         OrderItemConfiguration[]
  files                  OrderItemFile[]
  jobCards               ProductionJobCard[]

  @@index([orderId])
  @@index([productOfferingVersionId])
  @@index([priceSnapshotId])
  @@map("production_order_items")
}

model OrderItemConfiguration {
  id            String   @id @default(cuid())
  orderItemId   String   @map("order_item_id")
  fieldCode     String   @map("field_code")
  fieldLabel    String   @map("field_label")
  fieldType     String?  @map("field_type")
  optionId      String?  @map("option_id")
  selectedValue String   @map("selected_value")
  selectedLabel String   @map("selected_label")
  createdAt     DateTime @default(now()) @map("created_at")

  orderItem ProductionOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@index([optionId])
  @@index([fieldCode])
  @@map("order_item_configurations")
}

model OrderItemFile {
  id                   String   @id @default(cuid())
  orderItemId          String   @map("order_item_id")
  fileRequirementCode  String   @map("file_requirement_code")
  fileRequirementLabel String   @map("file_requirement_label")
  fileAssetId          String   @map("file_asset_id")
  createdAt            DateTime @default(now()) @map("created_at")

  orderItem ProductionOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  fileAsset FileAsset           @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)

  @@index([orderItemId])
  @@index([fileAssetId])
  @@map("order_item_files")
}

model WorkflowInstance {
  id                 String                 @id @default(cuid())
  orderId            String                 @map("order_id")
  workflowTemplateId String                 @map("workflow_template_id")
  status             WorkflowInstanceStatus @default(READY)
  currentStepOrder   Int                    @default(1) @map("current_step_order")
  startedAt          DateTime?              @map("started_at")
  completedAt        DateTime?              @map("completed_at")
  createdAt          DateTime               @default(now()) @map("created_at")

  order            ProductionOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  workflowTemplate WorkflowTemplate @relation(fields: [workflowTemplateId], references: [id], onDelete: Restrict)
  tasks            WorkflowTask[]
  jobCards         ProductionJobCard[]

  @@index([orderId])
  @@index([workflowTemplateId])
  @@index([status])
  @@map("workflow_instances")
}

model WorkflowTask {
  id                     String             @id @default(cuid())
  workflowInstanceId     String             @map("workflow_instance_id")
  workflowTemplateStepId String             @map("workflow_template_step_id")
  departmentId           String             @map("department_id")
  assignedToId           String?            @map("assigned_to_id")
  assignedDepartmentId   String?            @map("assigned_department_id")
  assignedMachineId      String?            @map("assigned_machine_id")
  status                 WorkflowTaskStatus @default(PENDING)
  queuedAt               DateTime?          @map("queued_at")
  assignedAt             DateTime?          @map("assigned_at")
  startedAt              DateTime?          @map("started_at")
  completedAt            DateTime?          @map("completed_at")
  dueAt                  DateTime?          @map("due_at")
  remarks                String?            @db.Text
  createdAt              DateTime           @default(now()) @map("created_at")

  workflowInstance   WorkflowInstance     @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)
  workflowStep       WorkflowTemplateStep @relation(fields: [workflowTemplateStepId], references: [id], onDelete: Restrict)
  department         Department           @relation("WorkflowTaskStepDepartment", fields: [departmentId], references: [id], onDelete: Restrict)
  assignedTo         User?                @relation("WorkflowTaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedDepartment Department?          @relation("WorkflowTaskAssignedDepartment", fields: [assignedDepartmentId], references: [id], onDelete: SetNull)
  assignedMachine    Machine?             @relation(fields: [assignedMachineId], references: [id], onDelete: SetNull)
  history            WorkflowTaskHistory[]
  reworks            ReworkRequest[]
  slaBreaches        WorkflowSlaBreach[]

  @@index([workflowInstanceId])
  @@index([departmentId])
  @@index([assignedToId])
  @@index([assignedDepartmentId])
  @@index([assignedMachineId])
  @@index([status])
  @@index([queuedAt])
  @@index([assignedAt])
  @@map("workflow_tasks")
}

model WorkflowTaskHistory {
  id            String                @id @default(cuid())
  taskId        String                @map("task_id")
  action        WorkflowHistoryAction
  remarks       String?               @db.Text
  performedById String?               @map("performed_by_id")
  createdAt     DateTime              @default(now()) @map("created_at")

  task        WorkflowTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  performedBy User?        @relation("WorkflowTaskHistoryPerformer", fields: [performedById], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([performedById])
  @@map("workflow_task_history")
}

model ReworkRequest {
  id          String       @id @default(cuid())
  taskId      String       @map("task_id")
  status      ReworkStatus @default(OPEN)
  reason      String       @db.Text
  notes       String?      @db.Text
  createdById String?      @map("created_by_id")
  createdAt   DateTime     @default(now()) @map("created_at")

  task      WorkflowTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdBy User?        @relation("ReworkRequestCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([createdById])
  @@index([status])
  @@map("rework_requests")
}

model WorkflowSlaBreach {
  id              String   @id @default(cuid())
  taskId          String   @map("task_id")
  expectedMinutes Int      @map("expected_minutes")
  actualMinutes   Int      @map("actual_minutes")
  breachMinutes   Int      @map("breach_minutes")
  createdAt       DateTime @default(now()) @map("created_at")

  task WorkflowTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("workflow_sla_breaches")
}

// =====================================================
// QUOTATION ENGINE
// Flow: Configure → Quote → Approve → Convert to ProductionOrder
// =====================================================

model Quote {
  id           String      @id @default(cuid())
  quoteNumber  String      @unique @map("quote_number")
  customerId   String      @map("customer_id")
  status       QuoteStatus @default(DRAFT)
  subtotal     Decimal     @db.Decimal(12, 2)
  taxAmount    Decimal     @map("tax_amount") @db.Decimal(12, 2)
  totalAmount  Decimal     @map("total_amount") @db.Decimal(12, 2)
  validityDate DateTime    @map("validity_date")
  notes        String?     @db.Text
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  customer         User              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items            QuoteItem[]
  productionOrders ProductionOrder[]

  @@index([customerId])
  @@index([status])
  @@index([validityDate])
  @@index([quoteNumber])
  @@map("quotes")
}

model QuoteItem {
  id                       String   @id @default(cuid())
  quoteId                  String   @map("quote_id")
  productOfferingVersionId String   @map("product_offering_version_id")
  priceSnapshotId          String?  @map("price_snapshot_id")
  quantity                 Int
  unitPrice                Decimal  @map("unit_price") @db.Decimal(12, 2)
  totalPrice               Decimal  @map("total_price") @db.Decimal(12, 2)
  createdAt                DateTime @default(now()) @map("created_at")

  quote                  Quote                  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productOfferingVersion ProductOfferingVersion @relation(fields: [productOfferingVersionId], references: [id], onDelete: Restrict)
  priceSnapshot          PriceSnapshot?         @relation(fields: [priceSnapshotId], references: [id], onDelete: Restrict)

  @@index([quoteId])
  @@index([productOfferingVersionId])
  @@index([priceSnapshotId])
  @@map("quote_items")
}

// =====================================================
// JOB CARD SYSTEM — shop floor execution unit
// Workers operate from job cards, not raw order records.
// =====================================================

model ProductionJobCard {
  id                     String                  @id @default(cuid())
  jobCardNumber          String                  @unique @map("job_card_number")
  productionOrderId      String                  @map("production_order_id")
  productionOrderItemId  String                  @map("production_order_item_id")
  workflowInstanceId     String                  @map("workflow_instance_id")
  currentStep            Int                     @default(1) @map("current_step")
  status                 ProductionJobCardStatus @default(PENDING)
  qrCode                 String                  @unique @map("qr_code")
  remarks                String?                 @db.Text
  snapshot               Json                    @default("{}")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  productionOrder     ProductionOrder     @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  productionOrderItem ProductionOrderItem @relation(fields: [productionOrderItemId], references: [id], onDelete: Cascade)
  workflowInstance    WorkflowInstance    @relation(fields: [workflowInstanceId], references: [id], onDelete: Restrict)

  @@index([productionOrderId])
  @@index([productionOrderItemId])
  @@index([workflowInstanceId])
  @@index([status])
  @@map("production_job_cards")
}

// =====================================================
// INVENTORY & BOM FOUNDATION (placeholder — no transactions yet)
// Future: paper, lamination film, UV chemical, foil, packaging materials.
// =====================================================

model MaterialCategory {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  materials Material[]

  @@index([isActive])
  @@map("material_categories")
}

model Material {
  id          String         @id @default(cuid())
  categoryId  String         @map("category_id")
  code        String         @unique
  name        String
  unit        String
  status      MaterialStatus @default(ACTIVE)
  metadata    Json           @default("{}")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  category       MaterialCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  bomTemplateItems BomTemplateItem[]

  @@index([categoryId])
  @@index([status])
  @@map("materials")
}

model BomTemplate {
  id                       String   @id @default(cuid())
  productOfferingVersionId String   @unique @map("product_offering_version_id")
  name                     String
  code                     String
  description              String?  @db.Text
  isActive                 Boolean  @default(true) @map("is_active")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  productOfferingVersion ProductOfferingVersion @relation(fields: [productOfferingVersionId], references: [id], onDelete: Cascade)
  items                  BomTemplateItem[]

  @@index([code])
  @@map("bom_templates")
}

model BomTemplateItem {
  id            String  @id @default(cuid())
  bomTemplateId String  @map("bom_template_id")
  materialId    String  @map("material_id")
  quantity      Decimal @db.Decimal(14, 4)
  unit          String?
  notes         String? @db.Text
  sortOrder     Int     @default(0) @map("sort_order")

  bomTemplate BomTemplate @relation(fields: [bomTemplateId], references: [id], onDelete: Cascade)
  material    Material    @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@unique([bomTemplateId, materialId])
  @@index([bomTemplateId])
  @@index([materialId])
  @@map("bom_template_items")
}

// =====================================================
// ENTERPRISE AUDIT LOG
// Compliance and accountability for catalog, pricing, workflow, and order changes.
// =====================================================

model AuditLog {
  id          String   @id @default(cuid())
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  action      String
  oldValues   Json?    @map("old_values")
  newValues   Json?    @map("new_values")
  changedById String?  @map("changed_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  changedBy User? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([changedById])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// LEGACY CHECKOUT ORDERS (wallet / e-commerce layer)
//
// This model serves the existing wallet and Razorpay checkout flow.
// ProductionOrder (above) is the primary ERP business order.
//
// Migration path (future):
// 1. Checkout creates Order + payment via wallet/Razorpay.
// 2. On confirmation, spawn ProductionOrder with version-pinned line items.
// 3. Link via Order.metadata.productionOrderId or dedicated FK when ready.
// 4. Deprecate OrderItem catalog fields once all flows use ProductionOrder.
// ─────────────────────────────────────────────────────────────────────────────

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique @map("order_number")
  userId        String      @map("user_id")
  status        OrderStatus @default(PENDING)
  subtotal      Decimal     @db.Decimal(12, 2)
  taxAmount     Decimal     @default(0) @map("tax_amount") @db.Decimal(12, 2)
  discountAmount Decimal    @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount   Decimal     @map("total_amount") @db.Decimal(12, 2)
  currency      String      @default("INR")
  notes         String?
  metadata      Json        @default("{}")
  placedAt      DateTime?   @map("placed_at")
  completedAt   DateTime?   @map("completed_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  deletedAt     DateTime?   @map("deleted_at")

  user       User        @relation(fields: [userId], references: [id])
  items      OrderItem[]
  walletTransactions WalletTransaction[]

  @@index([userId])
  @@index([status])
  @@index([orderNumber])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id                        String  @id @default(cuid())
  orderId                   String  @map("order_id")
  /// Legacy checkout line item — prefer ProductionOrderItem for ERP operations.
  productOfferingVersionId  String? @map("product_offering_version_id")
  /// Immutable pricing breakdown at order time
  priceSnapshotId           String? @map("price_snapshot_id")
  quantity                  Int
  unitPrice                 Decimal @map("unit_price") @db.Decimal(12, 2)
  totalPrice                Decimal @map("total_price") @db.Decimal(12, 2)
  metadata                  Json    @default("{}")

  order                  Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productOfferingVersion ProductOfferingVersion? @relation(fields: [productOfferingVersionId], references: [id], onDelete: Restrict)
  priceSnapshot          PriceSnapshot?          @relation(fields: [priceSnapshotId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productOfferingVersionId])
  @@index([priceSnapshotId])
  @@map("order_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// Wallet
// ─────────────────────────────────────────────────────────────────────────────

model Wallet {
  id             String    @id @default(cuid())
  userId         String    @unique @map("user_id")
  currentBalance Decimal   @default(0) @map("balance") @db.Decimal(14, 2)
  totalAdded     Decimal   @default(0) @map("total_added") @db.Decimal(14, 2)
  totalSpent     Decimal   @default(0) @map("total_spent") @db.Decimal(14, 2)
  totalRefunds   Decimal   @default(0) @map("total_refunds") @db.Decimal(14, 2)
  currency       String    @default("INR")
  isActive       Boolean   @default(true) @map("is_active")
  lastRechargeAt DateTime? @map("last_recharge_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
  payments     Payment[]
  snapshots    WalletBalanceSnapshot[]

  @@map("wallets")
}

model WalletTransaction {
  id              String                  @id @default(cuid())
  walletId        String                  @map("wallet_id")
  userId          String                  @map("user_id")
  orderId         String?                 @map("order_id")
  paymentId       String?                 @unique @map("payment_id")
  type            WalletTransactionType
  status          WalletTransactionStatus @default(PENDING)
  amount          Decimal                 @db.Decimal(14, 2)
  balanceBefore   Decimal                 @map("balance_before") @db.Decimal(14, 2)
  balanceAfter    Decimal                 @map("balance_after") @db.Decimal(14, 2)
  referenceNumber String?                 @unique @map("reference_number")
  reference       String?
  remarks         String?                 @db.Text
  description     String?
  paymentMethod   PaymentMethod?          @map("payment_method")
  metadata        Json                    @default("{}")
  createdById     String?                 @map("created_by_id")
  createdAt       DateTime                @default(now()) @map("created_at")

  wallet    Wallet   @relation(fields: [walletId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  order     Order?   @relation(fields: [orderId], references: [id])
  payment   Payment? @relation(fields: [paymentId], references: [id])
  createdBy User?    @relation("WalletTransactionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([walletId])
  @@index([userId])
  @@index([orderId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("wallet_transactions")
}

model Payment {
  id                    String         @id @default(cuid())
  userId                String         @map("user_id")
  walletId              String?        @map("wallet_id")
  amount                Decimal        @db.Decimal(14, 2)
  currency              String         @default("INR")
  status                PaymentStatus  @default(PENDING)
  paymentMethod         PaymentMethod  @default(UPI_QR) @map("payment_method")
  razorpayPaymentId     String?        @unique @map("razorpay_payment_id")
  razorpayOrderId       String?        @unique @map("razorpay_order_id")
  razorpayPaymentLinkId String?        @unique @map("razorpay_payment_link_id")
  razorpayQrId          String?        @unique @map("razorpay_qr_id")
  qrImageUrl            String?        @map("qr_image_url") @db.Text
  qrReference           String?        @map("qr_reference")
  idempotencyKey        String         @unique @map("idempotency_key")
  webhookVerified       Boolean        @default(false) @map("webhook_verified")
  expiresAt             DateTime?      @map("expires_at")
  paidAt                DateTime?      @map("paid_at")
  metadata              Json           @default("{}")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet       Wallet?             @relation(fields: [walletId], references: [id], onDelete: SetNull)
  transactions WalletTransaction[]
  webhookLogs  PaymentWebhookLog[]

  @@index([userId])
  @@index([walletId])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

model PaymentWebhookLog {
  id              String   @id @default(cuid())
  paymentId       String?  @map("payment_id")
  razorpayEventId String   @unique @map("razorpay_event_id")
  eventType       String   @map("event_type")
  signatureValid  Boolean  @default(false) @map("signature_valid")
  payload         Json
  processed       Boolean  @default(false)
  processError    String?  @map("process_error") @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([createdAt])
  @@map("payment_webhook_logs")
}

model FinancialAuditLog {
  id            String               @id @default(cuid())
  action        FinancialAuditAction
  targetUserId  String               @map("target_user_id")
  actorId       String?              @map("actor_id")
  walletId      String?              @map("wallet_id")
  paymentId     String?              @map("payment_id")
  transactionId String?              @map("transaction_id")
  amount        Decimal?             @db.Decimal(14, 2)
  balanceBefore Decimal?             @map("balance_before") @db.Decimal(14, 2)
  balanceAfter  Decimal?             @map("balance_after") @db.Decimal(14, 2)
  remarks       String?              @db.Text
  metadata      Json                 @default("{}")
  createdAt     DateTime             @default(now()) @map("created_at")

  targetUser User  @relation("FinancialAuditTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  actor      User? @relation("FinancialAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([targetUserId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("financial_audit_logs")
}

model WalletBalanceSnapshot {
  id        String   @id @default(cuid())
  walletId  String   @map("wallet_id")
  balance   Decimal  @db.Decimal(14, 2)
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([createdAt])
  @@map("wallet_balance_snapshots")
}

// ─────────────────────────────────────────────────────────────────────────────
// Contact (website inquiries)
// ─────────────────────────────────────────────────────────────────────────────

model ContactInquiry {
  id            String                   @id @default(cuid())
  referenceCode String                   @unique @map("reference_code")
  name          String
  email         String
  phone         String
  company       String?
  subject       ContactSubject
  message       String                   @db.Text
  status        ContactInquiryStatus     @default(NEW)
  priority      ContactInquiryPriority   @default(NORMAL)
  assignedToId  String?                  @map("assigned_to_id")
  resolvedAt    DateTime?                @map("resolved_at")
  resolvedById  String?                  @map("resolved_by_id")
  ipAddress     String?                  @map("ip_address")
  userAgent     String?                  @map("user_agent") @db.Text
  readAt        DateTime?                @map("read_at")
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")

  assignedTo User?                  @relation("ContactInquiryAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolvedBy User?                  @relation("ContactInquiryResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  notes      ContactInquiryNote[]
  activities ContactInquiryActivity[]

  @@index([status])
  @@index([priority])
  @@index([subject])
  @@index([createdAt])
  @@index([email])
  @@index([assignedToId])
  @@map("contact_inquiries")
}

model ContactInquiryNote {
  id        String   @id @default(cuid())
  inquiryId String   @map("inquiry_id")
  authorId  String   @map("author_id")
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  inquiry ContactInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  author  User           @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([inquiryId])
  @@index([authorId])
  @@index([createdAt])
  @@map("contact_inquiry_notes")
}

model ContactInquiryActivity {
  id        String                     @id @default(cuid())
  inquiryId String                     @map("inquiry_id")
  actorId   String?                    @map("actor_id")
  type      ContactInquiryActivityType
  metadata  Json                       @default("{}")
  createdAt DateTime                   @default(now()) @map("created_at")

  inquiry ContactInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  actor   User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([inquiryId])
  @@index([type])
  @@index([createdAt])
  @@map("contact_inquiry_activities")
}

// ─────────────────────────────────────────────────────────────────────────────
// Global sliders (CMS)
// ─────────────────────────────────────────────────────────────────────────────

model SliderSlide {
  id           String      @id @default(cuid())
  sliderKey    String      @default("global") @map("slider_key")
  title        String?
  description  String?     @db.Text
  imageUrl     String      @map("image_url")
  imageKey     String      @map("image_key")
  redirectUrl  String?     @map("redirect_url")
  displayOrder Int         @default(0) @map("display_order")
  status       SlideStatus @default(INACTIVE)
  startDate    DateTime?   @map("start_date")
  endDate      DateTime?   @map("end_date")
  notes        String?     @db.Text
  createdById  String?     @map("created_by_id")
  updatedById  String?     @map("updated_by_id")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  createdBy User? @relation("SliderSlideCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("SliderSlideUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([sliderKey])
  @@index([sliderKey, status])
  @@index([sliderKey, displayOrder])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@map("slider_slides")
}
