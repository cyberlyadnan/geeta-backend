  alerts       WorkflowTaskExecutionAlert[]

  @@index([workflowTaskId, status])
  @@index([operatorId, status])
  @@index([departmentId, status])
  @@index([startedAt(sort: Desc)])
  @@map("workflow_task_execution_sessions")
}

model WorkflowTaskExecutionInterval {
