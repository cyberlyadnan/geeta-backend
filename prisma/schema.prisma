model WorkflowTaskAssignment {
  id               String                       @id @default(cuid())
  workflowTaskId   String                       @map("workflow_task_id")
  operatorId       String                       @map("operator_id")
  departmentId     String                       @map("department_id")
  machineId        String?                      @map("machine_id")
  assignedById     String                       @map("assigned_by_id")
  assignedAt       DateTime                     @default(now()) @map("assigned_at")
  priority         WorkflowPriority             @default(NORMAL)
  dueAt            DateTime?                    @map("due_at")
  estimatedMinutes Int                          @map("estimated_minutes")
  remarks          String?                      @db.Text
  status           WorkflowTaskAssignmentStatus @default(ACTIVE)
  supersededAt     DateTime?                    @map("superseded_at")
  createdAt        DateTime                     @default(now()) @map("created_at")
  updatedAt        DateTime                     @updatedAt @map("updated_at")

  workflowTask WorkflowTask @relation(fields: [workflowTaskId], references: [id], onDelete: Cascade)
  operator     User         @relation("TaskAssignmentOperator", fields: [operatorId], references: [id], onDelete: Restrict)
