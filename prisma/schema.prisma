// ─────────────────────────────────────────────────────────────────────────────
// LEGACY CHECKOUT ORDERS (wallet / e-commerce layer)
//
// This model serves the existing wallet and Razorpay checkout flow.
// ProductionOrder (above) is the primary ERP business order.
//
// Migration path (future):
// 1. Checkout creates Order + payment via wallet/Razorpay.
// 2. On confirmation, spawn ProductionOrder with version-pinned line items.
// 3. Link via Order.metadata.productionOrderId or dedicated FK when ready.
// 4. Deprecate OrderItem catalog fields once all flows use ProductionOrder.
// ─────────────────────────────────────────────────────────────────────────────

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique @map("order_number")
  userId         String      @map("user_id")
  status         OrderStatus @default(PENDING)
  subtotal       Decimal     @db.Decimal(12, 2)
  taxAmount      Decimal     @default(0) @map("tax_amount") @db.Decimal(12, 2)
  discountAmount Decimal     @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount    Decimal     @map("total_amount") @db.Decimal(12, 2)
  currency       String      @default("INR")
  notes          String?
  metadata       Json        @default("{}")
  placedAt       DateTime?   @map("placed_at")
  completedAt    DateTime?   @map("completed_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  deletedAt      DateTime?   @map("deleted_at")

  user               User                @relation(fields: [userId], references: [id])
  items              OrderItem[]
  walletTransactions WalletTransaction[]

  @@index([userId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@index([orderNumber])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("orders")
}

model OrderItem {
  id                       String  @id @default(cuid())
  orderId                  String  @map("order_id")
  /// Legacy checkout line item — prefer ProductionOrderItem for ERP operations.
  productOfferingVersionId String? @map("product_offering_version_id")
  /// Immutable pricing breakdown at order time
  priceSnapshotId          String? @map("price_snapshot_id")
  quantity                 Int
  unitPrice                Decimal @map("unit_price") @db.Decimal(12, 2)
  totalPrice               Decimal @map("total_price") @db.Decimal(12, 2)
  metadata                 Json    @default("{}")

  order                  Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productOfferingVersion ProductOfferingVersion? @relation(fields: [productOfferingVersionId], references: [id], onDelete: Restrict)
  priceSnapshot          PriceSnapshot?          @relation(fields: [priceSnapshotId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productOfferingVersionId])
  @@index([priceSnapshotId])
  @@map("order_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// Wallet
// ─────────────────────────────────────────────────────────────────────────────

model Wallet {
  id             String    @id @default(cuid())
  userId         String    @unique @map("user_id")
  currentBalance Decimal   @default(0) @map("balance") @db.Decimal(14, 2)
  totalAdded     Decimal   @default(0) @map("total_added") @db.Decimal(14, 2)
  totalSpent     Decimal   @default(0) @map("total_spent") @db.Decimal(14, 2)
  totalRefunds   Decimal   @default(0) @map("total_refunds") @db.Decimal(14, 2)
  currency       String    @default("INR")
  isActive       Boolean   @default(true) @map("is_active")
  lastRechargeAt DateTime? @map("last_recharge_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
  payments     Payment[]
  snapshots    WalletBalanceSnapshot[]

  @@map("wallets")
}

model WalletTransaction {
  id                String                  @id @default(cuid())
  walletId          String                  @map("wallet_id")
  userId            String                  @map("user_id")
  orderId           String?                 @map("order_id")
  productionOrderId String?                 @map("production_order_id")
  paymentId         String?                 @unique @map("payment_id")
  type              WalletTransactionType
  status            WalletTransactionStatus @default(PENDING)
  amount            Decimal                 @db.Decimal(14, 2)
  balanceBefore     Decimal                 @map("balance_before") @db.Decimal(14, 2)
  balanceAfter      Decimal                 @map("balance_after") @db.Decimal(14, 2)
  referenceNumber   String?                 @unique @map("reference_number")
  reference         String?
  remarks           String?                 @db.Text
  description       String?
  paymentMethod     PaymentMethod?          @map("payment_method")
  metadata          Json                    @default("{}")
  createdById       String?                 @map("created_by_id")
  createdAt         DateTime                @default(now()) @map("created_at")

  wallet          Wallet           @relation(fields: [walletId], references: [id])
  user            User             @relation(fields: [userId], references: [id])
  order           Order?           @relation(fields: [orderId], references: [id])
  productionOrder ProductionOrder? @relation("ProductionOrderWalletTx", fields: [productionOrderId], references: [id], onDelete: SetNull)
  payment         Payment?         @relation(fields: [paymentId], references: [id])
  createdBy       User?            @relation("WalletTransactionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([walletId])
  @@index([userId])
  @@index([orderId])
  @@index([productionOrderId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("wallet_transactions")
}

model Payment {
  id                    String        @id @default(cuid())
  userId                String        @map("user_id")
  walletId              String?       @map("wallet_id")
  amount                Decimal       @db.Decimal(14, 2)
  currency              String        @default("INR")
  status                PaymentStatus @default(PENDING)
  paymentMethod         PaymentMethod @default(UPI_QR) @map("payment_method")
  razorpayPaymentId     String?       @unique @map("razorpay_payment_id")
  razorpayOrderId       String?       @unique @map("razorpay_order_id")
  razorpayPaymentLinkId String?       @unique @map("razorpay_payment_link_id")
  razorpayQrId          String?       @unique @map("razorpay_qr_id")
  qrImageUrl            String?       @map("qr_image_url") @db.Text
  qrReference           String?       @map("qr_reference")
  idempotencyKey        String        @unique @map("idempotency_key")
  webhookVerified       Boolean       @default(false) @map("webhook_verified")
  expiresAt             DateTime?     @map("expires_at")
  paidAt                DateTime?     @map("paid_at")
  metadata              Json          @default("{}")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
