// =====================================================
// PRINT JOB CONFIGURATION ENGINE
// Database-driven print production: specs, sizing, artwork, validation, coverage.
// =====================================================

enum PrintSizeStrategyType {
  FIXED_SIZE
  SHEET_BASED
  AREA_BASED
  CUSTOM_SIZE
  ROLL_BASED
  COVERAGE_BASED
}

enum SizeUnit {
  MM
  CM
  INCH
  FT
}

enum ValidationLevel {
  SUCCESS
  WARNING
  ERROR
}

enum ArtworkProcessingStatus {
  PENDING
  SCANNING
  VALIDATING
  ANALYZING
  GENERATING_PREVIEW
  COMPLETED
  FAILED
}

enum ArtworkApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

enum PrintColorMode {
  CMYK
  RGB
  GRAYSCALE
  SPOT
  ANY
}

enum PrintLayerRole {
  MAIN
  UV
  FOIL
  WHITE_INK
  SPOT_UV
  RAISED_UV
  SCREEN
  DIE_LINE
  CUSTOM
}

enum MasterConfigStatus {
  ACTIVE
  INACTIVE
}

enum SheetType {
  PAPER
  FLEX
  VINYL
  ROLL
  LARGE_FORMAT
  CUSTOM
}

// =====================================================
// PRINT MASTER CONFIGURATION (ERP-grade global masters)
// Products reference masters — no duplicated print logic.
// =====================================================

model MeasurementUnit {
  id          String             @id @default(cuid())
  code        String             @unique
  name        String
  symbol      String
  toMmFactor  Decimal            @map("to_mm_factor") @db.Decimal(16, 8)
  status      MasterConfigStatus @default(ACTIVE)
  sortOrder   Int                @default(0) @map("sort_order")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  deletedAt   DateTime?          @map("deleted_at")

  sheetSizes SheetSize[]

  @@index([status, deletedAt])
  @@map("measurement_units")
}

model SheetSize {
  id                 String             @id @default(cuid())
  code               String             @unique
  name               String
  width              Decimal            @db.Decimal(10, 2)
  height             Decimal            @db.Decimal(10, 2)
  measurementUnitId  String             @map("measurement_unit_id")
  aspectRatio        Decimal?           @map("aspect_ratio") @db.Decimal(10, 4)
  sheetType          SheetType          @default(PAPER) @map("sheet_type")
  description        String?            @db.Text
  sortOrder          Int                @default(0) @map("sort_order")
  status             MasterConfigStatus @default(ACTIVE)
  createdById        String?            @map("created_by_id")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  deletedAt          DateTime?          @map("deleted_at")

  measurementUnit MeasurementUnit   @relation(fields: [measurementUnitId], references: [id], onDelete: Restrict)
  createdBy       User?             @relation("SheetSizeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  templateItems   SizeTemplateItem[]

  @@index([status, deletedAt])
  @@index([sheetType])
  @@index([sortOrder])
  @@map("sheet_sizes")
}

model SizeTemplate {
  id           String                @id @default(cuid())
  code         String                @unique
  name         String
  strategyType PrintSizeStrategyType @map("strategy_type")
  config       Json                  @default("{}")
  description  String?               @db.Text
  sortOrder    Int                   @default(0) @map("sort_order")
  status       MasterConfigStatus    @default(ACTIVE)
  createdById  String?               @map("created_by_id")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")
  deletedAt    DateTime?             @map("deleted_at")

  createdBy        User?                  @relation("SizeTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items            SizeTemplateItem[]
  productVersions  ProductOfferingVersion[]
  productConfigs   ProductPrintConfig[]
  printProcesses   PrintProcess[]

  @@index([strategyType])
  @@index([status, deletedAt])
  @@map("size_templates")
}

model SizeTemplateItem {
  id             String   @id @default(cuid())
  sizeTemplateId String   @map("size_template_id")
  sheetSizeId    String?  @map("sheet_size_id")
  code           String
  label          String
  width          Decimal? @db.Decimal(10, 2)
  height         Decimal? @db.Decimal(10, 2)
  unitCode       String?  @map("unit_code")
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")

  sizeTemplate SizeTemplate @relation(fields: [sizeTemplateId], references: [id], onDelete: Cascade)
  sheetSize    SheetSize?   @relation(fields: [sheetSizeId], references: [id], onDelete: SetNull)

  @@unique([sizeTemplateId, code])
  @@index([sizeTemplateId])
  @@map("size_template_items")
}

model PrintProcess {
  id                      String             @id @default(cuid())
  code                    String             @unique
  name                    String
  description             String?            @db.Text
  supportedFileTypes      Json               @default("[]") @map("supported_file_types")
  supportedSizeStrategies Json               @default("[]") @map("supported_size_strategies")
  supportedValidationTypes Json              @default("[]") @map("supported_validation_types")
  pricingStrategyKey      String?            @map("pricing_strategy_key")
  defaultSizeTemplateId   String?            @map("default_size_template_id")
  sortOrder               Int                @default(0) @map("sort_order")
  status                  MasterConfigStatus @default(ACTIVE)
  createdById             String?            @map("created_by_id")
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")
  deletedAt               DateTime?          @map("deleted_at")

  defaultSizeTemplate SizeTemplate?            @relation(fields: [defaultSizeTemplateId], references: [id], onDelete: SetNull)
  createdBy           User?                    @relation("PrintProcessCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  productVersions     ProductOfferingVersion[]
  productConfigs      ProductPrintConfig[]

  @@index([status, deletedAt])
  @@map("print_processes")
}

model PrintSpecificationTemplate {
  id                   String             @id @default(cuid())
  code                 String             @unique
  name                 String
  description          String?            @db.Text
  allowedFormats       Json               @default("[]") @map("allowed_formats")
  requiredPages        Int?               @map("required_pages")
  pageNames            Json               @default("[]") @map("page_names")
  finishedWidthMm      Decimal?           @map("finished_width_mm") @db.Decimal(10, 2)
  finishedHeightMm     Decimal?           @map("finished_height_mm") @db.Decimal(10, 2)
  artworkWidthMm       Decimal?           @map("artwork_width_mm") @db.Decimal(10, 2)
  artworkHeightMm      Decimal?           @map("artwork_height_mm") @db.Decimal(10, 2)
  bleedMm              Decimal?           @map("bleed_mm") @db.Decimal(10, 2)
  safeAreaMm           Decimal?           @map("safe_area_mm") @db.Decimal(10, 2)
  minDpi               Int?               @map("min_dpi")
  maxFileSizeMb        Int?               @map("max_file_size_mb")
  colorMode            PrintColorMode     @default(ANY) @map("color_mode")
  previewEnabled       Boolean            @default(true) @map("preview_enabled")
  validationEnabled    Boolean            @default(true) @map("validation_enabled")
  autoArtworkAnalysis  Boolean            @default(true) @map("auto_artwork_analysis")
  coverageAnalysisEnabled Boolean         @default(false) @map("coverage_analysis_enabled")
  metadata             Json               @default("{}")
  sortOrder            Int                @default(0) @map("sort_order")
  status               MasterConfigStatus @default(ACTIVE)
  createdById          String?            @map("created_by_id")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  deletedAt            DateTime?          @map("deleted_at")

  createdBy       User?                    @relation("PrintSpecTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  productVersions ProductOfferingVersion[]
  productConfigs  ProductPrintConfig[]

  @@index([status, deletedAt])
  @@map("print_specification_templates")
}

model MasterArtworkRule {
  id          String             @id @default(cuid())
  code        String             @unique
  name        String
  ruleType    String             @map("rule_type")
  config      Json               @default("{}")
  failLevel   ValidationLevel    @default(ERROR) @map("fail_level")
  message     String?
  sortOrder   Int                @default(0) @map("sort_order")
  status      MasterConfigStatus @default(ACTIVE)
  createdById String?            @map("created_by_id")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  deletedAt   DateTime?          @map("deleted_at")

  createdBy User? @relation("MasterArtworkRuleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status, deletedAt])
  @@map("master_artwork_rules")
}

model MasterValidationRule {
  id              String             @id @default(cuid())
  code            String             @unique
  name            String
  ruleType        String             @map("rule_type")
  config          Json               @default("{}")
  failLevel       ValidationLevel    @default(ERROR) @map("fail_level")
  warningThreshold Decimal?          @map("warning_threshold") @db.Decimal(10, 4)
  errorThreshold   Decimal?          @map("error_threshold") @db.Decimal(10, 4)
  sortOrder       Int                @default(0) @map("sort_order")
  status          MasterConfigStatus @default(ACTIVE)
  createdById     String?            @map("created_by_id")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  deletedAt       DateTime?          @map("deleted_at")

  createdBy User? @relation("MasterValidationRuleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status, deletedAt])
  @@map("master_validation_rules")
}

model MasterCoverageRule {
  id                 String             @id @default(cuid())
  code               String             @unique
  name               String
  coverageType       String             @map("coverage_type")
  pricePerCm2        Decimal            @map("price_per_cm2") @db.Decimal(12, 4)
  minCharge          Decimal?           @map("min_charge") @db.Decimal(12, 2)
  maxCharge          Decimal?           @map("max_charge") @db.Decimal(12, 2)
  supportedFileTypes Json               @default("[]") @map("supported_file_types")
  validationRules    Json               @default("[]") @map("validation_rules")
  sortOrder          Int                @default(0) @map("sort_order")
  status             MasterConfigStatus @default(ACTIVE)
  createdById        String?            @map("created_by_id")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  deletedAt          DateTime?          @map("deleted_at")

  createdBy User? @relation("MasterCoverageRuleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status, deletedAt])
  @@map("master_coverage_rules")
}

model FileUploadRuleTemplate {
  id               String             @id @default(cuid())
  code             String             @unique
  name             String
  requirementType  FileRequirementType @map("requirement_type")
  maxFileSizeMb    Int?               @map("max_file_size_mb")
  allowMultiple    Boolean            @default(false) @map("allow_multiple")
  allowedFileTypes Json               @default("[]") @map("allowed_file_types")
  description      String?            @db.Text
  sortOrder        Int                @default(0) @map("sort_order")
  status           MasterConfigStatus @default(ACTIVE)
  createdById      String?            @map("created_by_id")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  deletedAt        DateTime?          @map("deleted_at")

  createdBy      User?                @relation("FileUploadRuleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  productConfigs ProductPrintConfig[]

  @@index([status, deletedAt])
  @@map("file_upload_rule_templates")
}

/// Links a product version to master print configuration (ERP product profile).
model ProductPrintConfig {
  id                           String   @id @default(cuid())
  productOfferingVersionId     String   @unique @map("product_offering_version_id")
  printProcessId               String?  @map("print_process_id")
  sizeTemplateId               String?  @map("size_template_id")
  printSpecificationTemplateId String?  @map("print_specification_template_id")
  fileUploadRuleTemplateId     String?  @map("file_upload_rule_template_id")
  artworkRuleIds               Json     @default("[]") @map("artwork_rule_ids")
  validationRuleIds            Json     @default("[]") @map("validation_rule_ids")
  coverageRuleIds              Json     @default("[]") @map("coverage_rule_ids")
  pricingStrategyKey           String?  @map("pricing_strategy_key")
  createdAt                    DateTime @default(now()) @map("created_at")
  updatedAt                    DateTime @updatedAt @map("updated_at")

  productOfferingVersion     ProductOfferingVersion     @relation(fields: [productOfferingVersionId], references: [id], onDelete: Cascade)
  printProcess               PrintProcess?              @relation(fields: [printProcessId], references: [id], onDelete: SetNull)
  sizeTemplate               SizeTemplate?              @relation(fields: [sizeTemplateId], references: [id], onDelete: SetNull)
  printSpecificationTemplate PrintSpecificationTemplate? @relation(fields: [printSpecificationTemplateId], references: [id], onDelete: SetNull)
  fileUploadRuleTemplate     FileUploadRuleTemplate?    @relation(fields: [fileUploadRuleTemplateId], references: [id], onDelete: SetNull)

  @@index([printProcessId])
  @@index([sizeTemplateId])
  @@map("product_print_configs")
}

/// Per-version print specification — fully admin-configurable, no hardcoded product logic.
model PrintSpecification {
  id                       String         @id @default(cuid())
  productOfferingVersionId String         @unique @map("product_offering_version_id")
  requiredPages            Int?           @map("required_pages")
  pageNames                Json           @default("[]") @map("page_names")
  artworkWidthMm           Decimal?       @map("artwork_width_mm") @db.Decimal(10, 2)
  artworkHeightMm          Decimal?       @map("artwork_height_mm") @db.Decimal(10, 2)
  finishedWidthMm          Decimal?       @map("finished_width_mm") @db.Decimal(10, 2)
  finishedHeightMm         Decimal?       @map("finished_height_mm") @db.Decimal(10, 2)
  bleedMm                  Decimal?       @map("bleed_mm") @db.Decimal(10, 2)
  safeAreaMm               Decimal?       @map("safe_area_mm") @db.Decimal(10, 2)
  minDpi                   Int?           @map("min_dpi")
  maxFileSizeMb            Int?           @map("max_file_size_mb")
  previewEnabled           Boolean        @default(true) @map("preview_enabled")
  colorMode                PrintColorMode @default(ANY) @map("color_mode")
  printingProcess          String?        @map("printing_process")
  validationRules          Json           @default("[]") @map("validation_rules")
  coverageTypes            Json           @default("[]") @map("coverage_types")
  allowedFormats           Json           @default("[]") @map("allowed_formats")
  metadata                 Json           @default("{}")
  createdAt                DateTime       @default(now()) @map("created_at")
  updatedAt                DateTime       @updatedAt @map("updated_at")

  productOfferingVersion ProductOfferingVersion @relation(fields: [productOfferingVersionId], references: [id], onDelete: Cascade)

  @@map("print_specifications")
}

/// Generic size strategy — strategy type + JSON config drives the Size Engine.
model PrintSizeStrategy {
  id                       String                @id @default(cuid())
  productOfferingVersionId String                @unique @map("product_offering_version_id")
  strategyType             PrintSizeStrategyType @map("strategy_type")
  config                   Json                  @default("{}")
  isActive                 Boolean               @default(true) @map("is_active")
  createdAt                DateTime              @default(now()) @map("created_at")
  updatedAt                DateTime              @updatedAt @map("updated_at")

  productOfferingVersion ProductOfferingVersion @relation(fields: [productOfferingVersionId], references: [id], onDelete: Cascade)
  sizeConfigurations     SizeConfiguration[]

  @@index([strategyType])
  @@map("print_size_strategies")
}

/// Preset or sheet sizes for FIXED_SIZE / SHEET_BASED strategies.
model SizeConfiguration {
  id                  String   @id @default(cuid())
  printSizeStrategyId String   @map("print_size_strategy_id")
  code                String
  label               String
  width               Decimal? @db.Decimal(10, 2)
  height              Decimal? @db.Decimal(10, 2)
  unit                SizeUnit @default(MM)
  sheetCode           String?  @map("sheet_code")
  areaCm2             Decimal? @map("area_cm2") @db.Decimal(12, 4)
  pricingKey          String?  @map("pricing_key")
  sortOrder           Int      @default(0) @map("sort_order")
  metadata            Json     @default("{}")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  printSizeStrategy PrintSizeStrategy @relation(fields: [printSizeStrategyId], references: [id], onDelete: Cascade)

  @@unique([printSizeStrategyId, code])
  @@index([printSizeStrategyId])
  @@map("size_configurations")
}

/// Admin-configurable artwork validation rules per version or file slot.
model ArtworkRule {
  id                       String          @id @default(cuid())
  productOfferingVersionId String          @map("product_offering_version_id")
  fileRequirementId        String?         @map("file_requirement_id")
  printLayerId             String?         @map("print_layer_id")
  ruleCode                 String          @map("rule_code")
  ruleType                 String          @map("rule_type")
  config                   Json            @default("{}")
  failLevel                ValidationLevel @default(ERROR) @map("fail_level")
  message                  String?
  isActive                 Boolean         @default(true) @map("is_active")
  sortOrder                Int             @default(0) @map("sort_order")
  createdAt                DateTime        @default(now()) @map("created_at")
  updatedAt                DateTime        @updatedAt @map("updated_at")

  productOfferingVersion ProductOfferingVersion @relation(fields: [productOfferingVersionId], references: [id], onDelete: Cascade)
  fileRequirement        FileRequirement?       @relation(fields: [fileRequirementId], references: [id], onDelete: SetNull)
  printLayer             PrintLayer?            @relation(fields: [printLayerId], references: [id], onDelete: SetNull)

  @@unique([productOfferingVersionId, ruleCode])
  @@index([productOfferingVersionId])
  @@index([fileRequirementId])
  @@map("artwork_rules")
}

/// Coverage-based pricing rules — Spot UV, Foiling, White Ink, etc.
model CoveragePricingRule {
  id                       String   @id @default(cuid())
  productOfferingVersionId String   @map("product_offering_version_id")
  code                     String
  label                    String
  coverageType             String   @map("coverage_type")
  pricePerCm2              Decimal  @map("price_per_cm2") @db.Decimal(12, 4)
  minCharge                Decimal? @map("min_charge") @db.Decimal(12, 2)
  maxCharge                Decimal? @map("max_charge") @db.Decimal(12, 2)
  supportedFileTypes       Json     @default("[]") @map("supported_file_types")
  validationRules          Json     @default("[]") @map("validation_rules")
  isActive                 Boolean  @default(true) @map("is_active")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  productOfferingVersion ProductOfferingVersion @relation(fields: [productOfferingVersionId], references: [id], onDelete: Cascade)
  printLayers            PrintLayer[]

  @@unique([productOfferingVersionId, code])
  @@index([productOfferingVersionId])
  @@map("coverage_pricing_rules")
}

/// Print layers — Main Artwork, UV Layer, Foil Layer, etc.
model PrintLayer {
  id                       String         @id @default(cuid())
  productOfferingVersionId String         @map("product_offering_version_id")
  fileRequirementId        String?        @unique @map("file_requirement_id")
  coveragePricingRuleId    String?        @map("coverage_pricing_rule_id")
  code                     String
  label                    String
  role                     PrintLayerRole @default(MAIN)
  isRequired               Boolean        @default(true) @map("is_required")
  sortOrder                Int            @default(0) @map("sort_order")
  metadata                 Json           @default("{}")
  createdAt                DateTime       @default(now()) @map("created_at")
  updatedAt                DateTime       @updatedAt @map("updated_at")

  productOfferingVersion ProductOfferingVersion @relation(fields: [productOfferingVersionId], references: [id], onDelete: Cascade)
  fileRequirement        FileRequirement?       @relation(fields: [fileRequirementId], references: [id], onDelete: SetNull)
  coveragePricingRule    CoveragePricingRule?   @relation(fields: [coveragePricingRuleId], references: [id], onDelete: SetNull)
  artworkRules           ArtworkRule[]
  artworkFiles           ArtworkFile[]

  @@unique([productOfferingVersionId, code])
  @@index([productOfferingVersionId])
  @@map("print_layers")
}

/// Artwork upload container — links to FileAsset, supports versioning.
model ArtworkFile {
  id                String                  @id @default(cuid())
  fileAssetId       String                  @unique @map("file_asset_id")
  fileRequirementId String?                 @map("file_requirement_id")
  printLayerId      String?                 @map("print_layer_id")
  ownerId           String                  @map("owner_id")
  versionId         String?                 @map("version_id")
  currentVersion    Int                     @default(1) @map("current_version")
  processingStatus  ArtworkProcessingStatus @default(PENDING) @map("processing_status")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  fileAsset       FileAsset        @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)
  fileRequirement FileRequirement? @relation(fields: [fileRequirementId], references: [id], onDelete: SetNull)
  printLayer      PrintLayer?      @relation(fields: [printLayerId], references: [id], onDelete: SetNull)
  owner           User             @relation("ArtworkFileOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  productVersion  ProductOfferingVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  versions        ArtworkVersion[]
  orderArtworks   OrderArtwork[]

  @@index([ownerId])
  @@index([fileRequirementId])
  @@index([versionId])
  @@map("artwork_files")
}

/// Immutable artwork version chain — never overwrite originals.
model ArtworkVersion {
  id               String                  @id @default(cuid())
  artworkFileId    String                  @map("artwork_file_id")
  versionNumber    Int                     @map("version_number")
  fileAssetId      String                  @map("file_asset_id")
  previewKey       String?                 @map("preview_key")
  previewUrl       String?                 @map("preview_url") @db.Text
  processingStatus ArtworkProcessingStatus @default(PENDING) @map("processing_status")
  virusScanPassed  Boolean?                @map("virus_scan_passed")
  createdAt        DateTime                @default(now()) @map("created_at")

  artworkFile       ArtworkFile        @relation(fields: [artworkFileId], references: [id], onDelete: Cascade)
  fileAsset         FileAsset          @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)
  metadata          ArtworkMetadata?
  validation        ArtworkValidation?
  coverageAnalyses  CoverageAnalysis[]
  orderArtworkPins  OrderArtworkVersion[]

  @@unique([artworkFileId, versionNumber])
  @@index([artworkFileId])
  @@index([fileAssetId])
  @@map("artwork_versions")
}

/// Extracted file metadata from processing pipeline.
model ArtworkMetadata {
  id               String         @id @default(cuid())
  artworkVersionId String         @unique @map("artwork_version_id")
  fileFormat       String         @map("file_format")
  widthPx          Int?           @map("width_px")
  heightPx         Int?           @map("height_px")
  widthMm          Decimal?       @map("width_mm") @db.Decimal(10, 2)
  heightMm         Decimal?       @map("height_mm") @db.Decimal(10, 2)
  dpi              Int?
  pageCount        Int?           @map("page_count")
  colorMode        PrintColorMode? @map("color_mode")
  hasTransparency  Boolean        @default(false) @map("has_transparency")
  rotation         Int            @default(0)
  fileSizeBytes    Int            @map("file_size_bytes")
  rawMetadata      Json           @default("{}") @map("raw_metadata")
  extractedAt      DateTime       @default(now()) @map("extracted_at")

  artworkVersion ArtworkVersion @relation(fields: [artworkVersionId], references: [id], onDelete: Cascade)

  @@map("artwork_metadata")
}

/// Validation report from Artwork Validation Engine.
model ArtworkValidation {
  id               String          @id @default(cuid())
  artworkVersionId String          @unique @map("artwork_version_id")
  overallLevel     ValidationLevel @map("overall_level")
  canProceed       Boolean         @map("can_proceed")
  checks           Json            @default("[]")
  validatedAt      DateTime        @default(now()) @map("validated_at")

  artworkVersion ArtworkVersion @relation(fields: [artworkVersionId], references: [id], onDelete: Cascade)

  @@map("artwork_validations")
}

/// Coverage analysis results — generic, not UV-specific.
model CoverageAnalysis {
  id               String   @id @default(cuid())
  artworkVersionId String   @map("artwork_version_id")
  coverageType     String   @map("coverage_type")
  coveragePercent  Decimal  @map("coverage_percent") @db.Decimal(8, 4)
  coverageMm2        Decimal  @map("coverage_mm2") @db.Decimal(14, 4)
  coverageCm2        Decimal  @map("coverage_cm2") @db.Decimal(12, 4)
  boundingBox      Json     @default("{}") @map("bounding_box")
  printablePixels  Int?     @map("printable_pixels")
  analysisData     Json     @default("{}") @map("analysis_data")
  analyzedAt       DateTime @default(now()) @map("analyzed_at")

  artworkVersion ArtworkVersion @relation(fields: [artworkVersionId], references: [id], onDelete: Cascade)

  @@index([artworkVersionId])
  @@index([coverageType])
  @@map("coverage_analyses")
}

/// Artwork pinned to a production order item.
model OrderArtwork {
  id                   String                @id @default(cuid())
  orderItemId          String                @map("order_item_id")
  artworkFileId        String                @map("artwork_file_id")
  fileRequirementCode  String                @map("file_requirement_code")
  printLayerCode       String?               @map("print_layer_code")
  approvalStatus       ArtworkApprovalStatus @default(PENDING) @map("approval_status")
  adminNotes           String?               @map("admin_notes") @db.Text
  approvedById         String?               @map("approved_by_id")
  approvedAt           DateTime?             @map("approved_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  orderItem     ProductionOrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  artworkFile   ArtworkFile           @relation(fields: [artworkFileId], references: [id], onDelete: Restrict)
  approvedBy    User?                 @relation("OrderArtworkApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  pinnedVersion OrderArtworkVersion?

  @@index([orderItemId])
  @@index([artworkFileId])
  @@index([approvalStatus])
  @@map("order_artworks")
}

/// Snapshot of artwork version at order submission time.
model OrderArtworkVersion {
  id               String   @id @default(cuid())
  orderArtworkId   String   @unique @map("order_artwork_id")
  artworkVersionId String   @map("artwork_version_id")
  pinnedAt         DateTime @default(now()) @map("pinned_at")

  orderArtwork   OrderArtwork   @relation(fields: [orderArtworkId], references: [id], onDelete: Cascade)
  artworkVersion ArtworkVersion @relation(fields: [artworkVersionId], references: [id], onDelete: Restrict)

  @@index([artworkVersionId])
  @@map("order_artwork_versions")
}
