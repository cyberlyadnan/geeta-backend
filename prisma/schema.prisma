// ─────────────────────────────────────────────────────────────────────────────
// Financial Event Ledger + Udhar (Credit) — Phase 2
// ─────────────────────────────────────────────────────────────────────────────

/// Append-only record of every money movement in the system (non-negotiable #3). Never edited,
/// never deleted. Read-optimized audit/report layer sitting on top of the row-locked wallet and
/// credit-account balance logic — not a replacement for it. actorId is polymorphic (points at a
/// User.id when actorType is VENDOR, a RetailCustomer.id when RETAIL_CUSTOMER) so it is
/// intentionally not a foreign key — the same pattern the doc specifies for CreditAccount below.
model FinancialEvent {
  id              String                   @id @default(cuid())
  actorType       FinancialActorType       @map("actor_type")
  actorId         String                   @map("actor_id")
  eventType       FinancialEventType       @map("event_type")
  amount          Decimal                  @db.Decimal(14, 2)
  direction       FinancialEventDirection
  instrument      FinancialInstrument
  referenceType   FinancialReferenceType   @map("reference_type")
  referenceId     String                   @map("reference_id")
  createdByUserId String?                  @map("created_by_user_id")
  createdAt       DateTime                 @default(now()) @map("created_at")

  createdByUser User? @relation("FinancialEventCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([actorType, actorId, createdAt(sort: Desc)])
  @@index([referenceType, referenceId])
  @@index([eventType])
  @@map("financial_events")
}

/// One credit (Udhar) account per actor. Limit is set explicitly by an admin before any draw is
/// possible — there is no auto-create-on-first-draw behavior. actorId is polymorphic, same
/// reasoning as FinancialEvent above.
model CreditAccount {
  id                 String   @id @default(cuid())
  actorType          FinancialActorType @map("actor_type")
  actorId            String   @map("actor_id")
  creditLimit        Decimal  @map("credit_limit") @db.Decimal(14, 2)
  outstandingBalance Decimal  @default(0) @map("outstanding_balance") @db.Decimal(14, 2)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  transactions CreditTransaction[]

  @@unique([actorType, actorId])
  @@map("credit_accounts")
}

/// Append-only draw/repayment history for a CreditAccount. Every row here has exactly one
/// corresponding FinancialEvent row (instrument = UDHAR).
model CreditTransaction {
  id                String                  @id @default(cuid())
  creditAccountId   String                  @map("credit_account_id")
  type              CreditTransactionType
  amount            Decimal                 @db.Decimal(14, 2)
  referenceType     FinancialReferenceType? @map("reference_type")
  referenceId       String?                 @map("reference_id")
  recordedByUserId  String                  @map("recorded_by_user_id")
  note              String?                 @db.Text
  createdAt         DateTime                @default(now()) @map("created_at")

  creditAccount  CreditAccount @relation(fields: [creditAccountId], references: [id], onDelete: Cascade)
  recordedByUser User          @relation("CreditTransactionRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@index([creditAccountId, createdAt(sort: Desc)])
  @@map("credit_transactions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Product Type Profiles + Design Approval — Phase 4
// ─────────────────────────────────────────────────────────────────────────────

/// Non-negotiable #4: a product type is a data profile, not a code branch. Deliberately minimal
/// — just enough to carry the CATALOG_DESIGN_APPROVAL flow. `wizardStepsKey` names a frontend
/// step sequence; the frontend picks a sequence by key, it does NOT interpret this row as a
/// generic wizard definition (that engine is explicitly out of scope this phase).
model ProductTypeProfile {
  id                     String          @id @default(cuid())
  key                    String          @unique
  name                   String
  sizeMode               ProductSizeMode @map("size_mode")
  /// Matches the strategy strings resolvePrice() dispatches on: "matrix" | "flex_area" |
  /// "fixed_catalog" | "quantity_pricing".
  pricingStrategyKey     String          @map("pricing_strategy_key")
  wizardStepsKey         String          @map("wizard_steps_key")
  /// NOT_OFFERED: no design section at all, artwork upload only. OPTIONAL: vendor chooses between
  /// uploading finished artwork or asking for design help. REQUIRED: always routes through design,
  /// no print-ready-artwork question is asked.
  designServiceMode      DesignServiceMode @default(NOT_OFFERED) @map("design_service_mode")
  /// Deprecated — superseded by designServiceMode. Kept in the schema (unread by application
  /// code) rather than dropped: removing this field from a model this deeply relation-connected
  /// pushes several unrelated Prisma include queries past a TypeScript type-instantiation-depth
  /// cliff, which silently falls back to wrong/incomplete inferred types elsewhere (verified by
  /// isolated testing — reproduces with ANY field removal here, not specific to this one). Safe
  /// to actually drop later in a dedicated pass once that TS/schema fragility is addressed on its
  /// own, decoupled from this feature.
  requiresDesignApproval Boolean           @default(false) @map("requires_design_approval")
  /// Default design fee, applied to a new DesignTask unless overridden per order. Changing this
  /// NEVER retroactively changes DesignTask.price on existing orders — that column is a snapshot
  /// taken at DesignTask-creation time, same pattern ProductOfferingVersion uses for pricing so
  /// historical orders are immune to later catalog edits.
  defaultDesignPrice     Decimal?        @map("default_design_price") @db.Decimal(12, 2)
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  productVersions ProductOfferingVersion[]

  @@map("product_type_profiles")
}

/// One design job per order. Exists only for products whose profile requires design approval and
/// where the vendor did not supply print-ready artwork.
///
/// `orderId` references ProductionOrder, not the legacy `Order` model the plan doc's sketch
/// named — ProductionOrder is the order entity every flow since Phase 1 actually uses.
model DesignTask {
  id               String           @id @default(cuid())
  orderId          String           @unique @map("order_id")
  source           DesignTaskSource
  /// Raw text/notes supplied by the vendor when source is VENDOR_MATTER.
  matterContent    String?          @map("matter_content") @db.Text
  assignedToUserId String?          @map("assigned_to_user_id")
  status           DesignTaskStatus @default(PENDING)
  /// Latest digital proof. Superseded proofs stay in DesignProofVersion for history.
  proofUrl         String?          @map("proof_url") @db.Text
  /// Rounds the vendor sent back, across BOTH gates. No cap is enforced yet — the client has not
  /// specified one; this is tracked so a limit can be added later without a schema change.
  revisionCount    Int              @default(0) @map("revision_count")
  /// Snapshot of the design fee actually applied to this order — copied from
  /// ProductTypeProfile.defaultDesignPrice at creation, or the staff-entered override. Never
  /// recomputed from the default afterward, so later default-price changes cannot alter history.
  price            Decimal?         @db.Decimal(12, 2)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  order        ProductionOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  assignedTo   User?                @relation("DesignTaskAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  proofs       DesignProofVersion[]
  decisions    DesignApprovalDecision[]
  attachments  DesignTaskAttachment[]

  @@index([status])
  @@index([assignedToUserId])
  @@map("design_tasks")
}

/// Reference material (photos, logos, existing artwork to redo) the vendor uploaded when
/// requesting design help — separate from ArtworkFile, which is print-ready output, not input.
model DesignTaskAttachment {
  id           String   @id @default(cuid())
  designTaskId String   @map("design_task_id")
  fileAssetId  String   @unique @map("file_asset_id")
  createdAt    DateTime @default(now()) @map("created_at")

  designTask DesignTask @relation(fields: [designTaskId], references: [id], onDelete: Cascade)
  fileAsset  FileAsset  @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)

  @@index([designTaskId])
  @@map("design_task_attachments")
}

/// Append-only history of every proof the design team submitted, so a vendor can see what
/// changed between rounds rather than only the latest file.
model DesignProofVersion {
  id            String   @id @default(cuid())
  designTaskId  String   @map("design_task_id")
  versionNumber Int      @map("version_number")
  proofUrl      String   @map("proof_url") @db.Text
  notes         String?  @db.Text
  submittedById String   @map("submitted_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  designTask  DesignTask @relation(fields: [designTaskId], references: [id], onDelete: Cascade)
  submittedBy User       @relation("DesignProofSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)

  @@unique([designTaskId, versionNumber])
  @@index([designTaskId])
  @@map("design_proof_versions")
}

/// Append-only record of each vendor decision at either gate — the audit trail behind
/// revisionCount, and what the vendor-facing timeline renders.
model DesignApprovalDecision {
  id             String             @id @default(cuid())
  designTaskId   String             @map("design_task_id")
  gate           DesignApprovalGate
  approved       Boolean
  revisionNote   String?            @map("revision_note") @db.Text
  decidedByUserId String            @map("decided_by_user_id")
  /// The workflow task this decision closed, for tracing back into the production timeline.
  workflowTaskId String?            @map("workflow_task_id")
  createdAt      DateTime           @default(now()) @map("created_at")

  designTask DesignTask @relation(fields: [designTaskId], references: [id], onDelete: Cascade)
  decidedBy  User       @relation("DesignApprovalDecider", fields: [decidedByUserId], references: [id], onDelete: Restrict)

  @@index([designTaskId, createdAt(sort: Desc)])
  @@map("design_approval_decisions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Dispatch & Delivery — Phase 3
// ─────────────────────────────────────────────────────────────────────────────

/// A daily dispatch window. Orders that become ready for dispatch are assigned to the first
/// shift whose cutoff has not yet passed; once the last shift of the day is past, they roll to
/// the first shift of the next day.
model DeliveryShift {
  id       String  @id @default(cuid())
  label    String
  /// "HH:mm" 24-hour local time. Stored as text (not DateTime) because this is a recurring
  /// time-of-day, not an instant — and it sorts correctly lexicographically in this format.
  cutoffTime String @map("cutoff_time")
  sortOrder Int     @default(0) @map("sort_order")
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  batches DispatchBatch[]

  @@index([isActive, cutoffTime])
  @@map("delivery_shifts")
}

/// One batch per (actor, shift, dispatch day) — orders accumulate into an existing open batch
/// rather than each creating their own. vendorId/retailCustomerId are mutually exclusive,
/// mirroring ProductionOrder's XOR (enforced by a CHECK constraint in the migration).
model DispatchBatch {
  id               String              @id @default(cuid())
  vendorId         String?             @map("vendor_id")
  retailCustomerId String?             @map("retail_customer_id")
  shiftId          String              @map("shift_id")
  /// Local calendar day this batch dispatches on, as "YYYY-MM-DD". Part of the batch identity:
  /// the same vendor + same shift on a different day is a different batch.
  dispatchDate     String              @map("dispatch_date")
  status           DispatchBatchStatus @default(AWAITING_READY)
  /// Entered manually by the dispatcher; null until then. Retained while a batch is held so a
  /// wallet top-up can retry billing without the dispatcher re-entering it.
  deliveryCharge   Decimal?            @map("delivery_charge") @db.Decimal(12, 2)
  /// Shortfall recorded when billing was blocked, so the dispatcher UI can show why.
  heldShortfall    Decimal?            @map("held_shortfall") @db.Decimal(12, 2)
  heldAt           DateTime?           @map("held_at")
  billedAt         DateTime?           @map("billed_at")
  dispatchedAt     DateTime?           @map("dispatched_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  shift          DeliveryShift        @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  vendor         User?                @relation("DispatchBatchVendor", fields: [vendorId], references: [id], onDelete: Restrict)
  retailCustomer RetailCustomer?      @relation(fields: [retailCustomerId], references: [id], onDelete: Restrict)
  orders         DispatchBatchOrder[]
  invoice        Invoice?

  @@unique([vendorId, shiftId, dispatchDate])
  @@unique([retailCustomerId, shiftId, dispatchDate])
  @@index([status, dispatchDate])
  @@index([shiftId, status])
  @@map("dispatch_batches")
}

model DispatchBatchOrder {
  id              String   @id @default(cuid())
  dispatchBatchId String   @map("dispatch_batch_id")
  orderId         String   @unique @map("order_id")
  createdAt       DateTime @default(now()) @map("created_at")

  dispatchBatch DispatchBatch   @relation(fields: [dispatchBatchId], references: [id], onDelete: Cascade)
  order         ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([dispatchBatchId])
  @@map("dispatch_batch_orders")
}

/// Consolidated GST invoice for one dispatch batch. invoiceNumber is allocated from
/// InvoiceNumberSequence inside the same transaction that creates this row, so numbering is
/// sequential and gapless (a rolled-back invoice rolls back its number too).
model Invoice {
  id              String             @id @default(cuid())
  invoiceNumber   String             @unique @map("invoice_number")
  dispatchBatchId String             @unique @map("dispatch_batch_id")
  actorType       FinancialActorType @map("actor_type")
  actorId         String             @map("actor_id")
  /// Snapshot of the billed party's GST number at invoice time — null for unregistered retail.
  /// Snapshotted rather than joined so a later profile edit cannot alter an issued invoice.
  gstNumber       String?            @map("gst_number")
  billedToName    String             @map("billed_to_name")
  /// Sum of the orders' pre-tax subtotals.
  subtotal        Decimal            @db.Decimal(12, 2)
  deliveryCharge  Decimal            @map("delivery_charge") @db.Decimal(12, 2)
  gstRate         Decimal            @map("gst_rate") @db.Decimal(5, 4)
  gstAmount       Decimal            @map("gst_amount") @db.Decimal(12, 2)
  total           Decimal            @db.Decimal(12, 2)
  pdfUrl          String?            @map("pdf_url") @db.Text
  createdAt       DateTime           @default(now()) @map("created_at")

  dispatchBatch DispatchBatch @relation(fields: [dispatchBatchId], references: [id], onDelete: Restrict)

  @@index([actorType, actorId, createdAt(sort: Desc)])
  @@map("invoices")
}

/// Gapless per-year invoice counter: INV-2026-000001. Same upsert+increment pattern as
/// OrderNumberSequence — the row lock serialises concurrent allocations, and because the
/// increment runs inside the invoice transaction, a rollback returns the number.
model InvoiceNumberSequence {
  year      Int @id
  lastValue Int @default(0) @map("last_value")

  @@map("invoice_number_sequences")
}

// ─────────────────────────────────────────────────────────────────────────────
// Contact (website inquiries)
// ─────────────────────────────────────────────────────────────────────────────

model ContactInquiry {
