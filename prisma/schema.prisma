// Geeta Print ERP - Database Schema
// Scalable relational architecture for enterprise printing operations

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  MANAGER
  STAFF
  CUSTOMER
  VENDOR
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  IN_PRODUCTION
  QUALITY_CHECK
  READY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum WalletTransactionType {
  CREDIT
  DEBIT
  REFUND
  ADJUSTMENT
  PROMOTIONAL
  ORDER_PAYMENT
  RECHARGE
  ADMIN_CREDIT
  ADMIN_DEBIT
  HOLD
  RELEASE
}

enum WalletTransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
  REVERSED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  EXPIRED
  REFUNDED
}

enum PaymentMethod {
  UPI_QR
  UPI
  CARD
  NETBANKING
  WALLET
  OTHER
}

enum FinancialAuditAction {
  WALLET_CREDIT
  WALLET_DEBIT
  PAYMENT_CREATED
  PAYMENT_WEBHOOK
  PAYMENT_REFUND
}

enum ContactSubject {
  QUOTE
  ORDER
  PARTNERSHIP
  SUPPORT
  OTHER
}

enum ContactInquiryStatus {
  NEW
  READ
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}

enum ContactInquiryPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ContactInquiryActivityType {
  CREATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  ASSIGNED
  UNASSIGNED
  NOTE_ADDED
  READ
}

enum VendorAccountStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
  UNDER_REVIEW
  DOCUMENT_REQUIRED
  BLOCKED
}

enum ActivityAction {
  VENDOR_REGISTERED
  VENDOR_STATUS_CHANGED
  VENDOR_VERIFIED
  VENDOR_REJECTED
  VENDOR_SUSPENDED
  ADMIN_NOTE_ADDED
  USER_LOGIN
  USER_LOGIN_BLOCKED
  USER_CREATED
}

enum SlideStatus {
  ACTIVE
  INACTIVE
  SCHEDULED
  EXPIRED
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth & Users
// ─────────────────────────────────────────────────────────────────────────────

model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  displayName String   @map("display_name")
  description String?
  permissions Json     @default("[]")
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("roles")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  firstName    String     @map("first_name")
  lastName     String     @map("last_name")
  phone        String?    @unique
  avatarUrl    String?    @map("avatar_url")
  status       UserStatus @default(PENDING_VERIFICATION)
  roleId       String     @map("role_id")
  lastLoginAt  DateTime?  @map("last_login_at")
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  role               Role               @relation(fields: [roleId], references: [id])
  refreshTokens      RefreshToken[]
  orders             Order[]
  wallet             Wallet?
  walletTransactions WalletTransaction[]
  payments           Payment[]
  financialAuditsAsTarget FinancialAuditLog[] @relation("FinancialAuditTarget")
  financialAuditsAsActor  FinancialAuditLog[] @relation("FinancialAuditActor")
  walletTransactionsCreated WalletTransaction[] @relation("WalletTransactionCreatedBy")
  vendorProfile      VendorProfile?
  vendorsVerified    VendorProfile[]    @relation("VendorVerifiedBy")
  vendorsRejected    VendorProfile[]    @relation("VendorRejectedBy")
  adminNotes         AdminNote[]        @relation("AdminNoteAuthor")
  activityLogs       ActivityLog[]      @relation("ActivityActor")
  sliderSlidesCreated SliderSlide[]     @relation("SliderSlideCreatedBy")
  sliderSlidesUpdated SliderSlide[]     @relation("SliderSlideUpdatedBy")
  assignedContactInquiries ContactInquiry[] @relation("ContactInquiryAssignee")
  resolvedContactInquiries ContactInquiry[] @relation("ContactInquiryResolver")
  contactInquiryNotes      ContactInquiryNote[]
  contactInquiryActivities ContactInquiryActivity[]

  @@index([roleId])
  @@index([status])
  @@index([phone])
  @@index([deletedAt])
  @@map("users")
}

model VendorCodeSequence {
  id        Int @id @default(1)
  lastValue Int @default(1000) @map("last_value")

  @@map("vendor_code_sequences")
}

model VendorProfile {
  id                  String              @id @default(cuid())
  vendorCode          String              @unique @map("vendor_code")
  userId              String              @unique @map("user_id")
  businessName        String              @map("business_name")
  ownerName           String              @map("owner_name")
  alternatePhone      String?             @map("alternate_phone")
  gstNumber           String?             @map("gst_number")
  referenceCode       String?             @map("reference_code")
  employeeCode        String?             @map("employee_code")
  country             String              @default("India")
  state               String?
  district            String?
  city                String?
  pinCode             String              @map("pin_code")
  fullAddress         String              @map("full_address") @db.Text
  businessType        String?             @map("business_type")
  services            Json                @default("[]")
  accountStatus       VendorAccountStatus @default(PENDING) @map("account_status")
  verificationRemarks String?             @map("verification_remarks") @db.Text
  verifiedAt          DateTime?           @map("verified_at")
  verifiedById        String?             @map("verified_by_id")
  rejectedAt          DateTime?           @map("rejected_at")
  rejectedById        String?             @map("rejected_by_id")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy User? @relation("VendorVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  rejectedBy User? @relation("VendorRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  adminNotes AdminNote[]
  activities ActivityLog[] @relation("VendorActivity")

  @@index([accountStatus])
  @@index([businessName])
  @@index([vendorCode])
  @@index([createdAt])
  @@map("vendor_profiles")
}

model AdminNote {
  id              String   @id @default(cuid())
  vendorProfileId String   @map("vendor_profile_id")
  authorId        String   @map("author_id")
  content         String   @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  vendorProfile VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  author        User          @relation("AdminNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([vendorProfileId])
  @@index([authorId])
  @@index([createdAt])
  @@map("admin_notes")
}

model ActivityLog {
  id              String         @id @default(cuid())
  action          ActivityAction
  entityType      String         @map("entity_type")
  entityId        String         @map("entity_id")
  vendorProfileId String?        @map("vendor_profile_id")
  actorId         String?        @map("actor_id")
  metadata        Json           @default("{}")
  ipAddress       String?        @map("ip_address")
  userAgent       String?        @map("user_agent") @db.Text
  createdAt       DateTime       @default(now()) @map("created_at")

  vendorProfile VendorProfile? @relation("VendorActivity", fields: [vendorProfileId], references: [id], onDelete: Cascade)
  actor         User?          @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([vendorProfileId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// Catalog
// ─────────────────────────────────────────────────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  parentId    String?  @map("parent_id")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([parentId])
  @@index([isActive])
  @@map("categories")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  sku         String?  @unique
  description String?
  basePrice   Decimal  @map("base_price") @db.Decimal(12, 2)
  categoryId  String   @map("category_id")
  metadata    Json     @default("{}")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  category Category @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([isActive])
  @@map("products")
}

// ─────────────────────────────────────────────────────────────────────────────
// Orders
// ─────────────────────────────────────────────────────────────────────────────

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique @map("order_number")
  userId        String      @map("user_id")
  status        OrderStatus @default(PENDING)
  subtotal      Decimal     @db.Decimal(12, 2)
  taxAmount     Decimal     @default(0) @map("tax_amount") @db.Decimal(12, 2)
  discountAmount Decimal    @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount   Decimal     @map("total_amount") @db.Decimal(12, 2)
  currency      String      @default("INR")
  notes         String?
  metadata      Json        @default("{}")
  placedAt      DateTime?   @map("placed_at")
  completedAt   DateTime?   @map("completed_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  deletedAt     DateTime?   @map("deleted_at")

  user       User        @relation(fields: [userId], references: [id])
  items      OrderItem[]
  walletTransactions WalletTransaction[]

  @@index([userId])
  @@index([status])
  @@index([orderNumber])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String  @map("order_id")
  productId String  @map("product_id")
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  totalPrice Decimal @map("total_price") @db.Decimal(12, 2)
  metadata  Json    @default("{}")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// Wallet
// ─────────────────────────────────────────────────────────────────────────────

model Wallet {
  id             String    @id @default(cuid())
  userId         String    @unique @map("user_id")
  currentBalance Decimal   @default(0) @map("balance") @db.Decimal(14, 2)
  totalAdded     Decimal   @default(0) @map("total_added") @db.Decimal(14, 2)
  totalSpent     Decimal   @default(0) @map("total_spent") @db.Decimal(14, 2)
  totalRefunds   Decimal   @default(0) @map("total_refunds") @db.Decimal(14, 2)
  currency       String    @default("INR")
  isActive       Boolean   @default(true) @map("is_active")
  lastRechargeAt DateTime? @map("last_recharge_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
  payments     Payment[]
  snapshots    WalletBalanceSnapshot[]

  @@map("wallets")
}

model WalletTransaction {
  id              String                  @id @default(cuid())
  walletId        String                  @map("wallet_id")
  userId          String                  @map("user_id")
  orderId         String?                 @map("order_id")
  paymentId       String?                 @unique @map("payment_id")
  type            WalletTransactionType
  status          WalletTransactionStatus @default(PENDING)
  amount          Decimal                 @db.Decimal(14, 2)
  balanceBefore   Decimal                 @map("balance_before") @db.Decimal(14, 2)
  balanceAfter    Decimal                 @map("balance_after") @db.Decimal(14, 2)
  referenceNumber String?                 @unique @map("reference_number")
  reference       String?
  remarks         String?                 @db.Text
  description     String?
  paymentMethod   PaymentMethod?          @map("payment_method")
  metadata        Json                    @default("{}")
  createdById     String?                 @map("created_by_id")
  createdAt       DateTime                @default(now()) @map("created_at")

  wallet    Wallet   @relation(fields: [walletId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  order     Order?   @relation(fields: [orderId], references: [id])
  payment   Payment? @relation(fields: [paymentId], references: [id])
  createdBy User?    @relation("WalletTransactionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([walletId])
  @@index([userId])
  @@index([orderId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("wallet_transactions")
}

model Payment {
  id                    String         @id @default(cuid())
  userId                String         @map("user_id")
  walletId              String?        @map("wallet_id")
  amount                Decimal        @db.Decimal(14, 2)
  currency              String         @default("INR")
  status                PaymentStatus  @default(PENDING)
  paymentMethod         PaymentMethod  @default(UPI_QR) @map("payment_method")
  razorpayPaymentId     String?        @unique @map("razorpay_payment_id")
  razorpayOrderId       String?        @unique @map("razorpay_order_id")
  razorpayPaymentLinkId String?        @unique @map("razorpay_payment_link_id")
  razorpayQrId          String?        @unique @map("razorpay_qr_id")
  qrImageUrl            String?        @map("qr_image_url") @db.Text
  qrReference           String?        @map("qr_reference")
  idempotencyKey        String         @unique @map("idempotency_key")
  webhookVerified       Boolean        @default(false) @map("webhook_verified")
  expiresAt             DateTime?      @map("expires_at")
  paidAt                DateTime?      @map("paid_at")
  metadata              Json           @default("{}")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet       Wallet?             @relation(fields: [walletId], references: [id], onDelete: SetNull)
  transactions WalletTransaction[]
  webhookLogs  PaymentWebhookLog[]

  @@index([userId])
  @@index([walletId])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

model PaymentWebhookLog {
  id              String   @id @default(cuid())
  paymentId       String?  @map("payment_id")
  razorpayEventId String   @unique @map("razorpay_event_id")
  eventType       String   @map("event_type")
  signatureValid  Boolean  @default(false) @map("signature_valid")
  payload         Json
  processed       Boolean  @default(false)
  processError    String?  @map("process_error") @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([createdAt])
  @@map("payment_webhook_logs")
}

model FinancialAuditLog {
  id            String               @id @default(cuid())
  action        FinancialAuditAction
  targetUserId  String               @map("target_user_id")
  actorId       String?              @map("actor_id")
  walletId      String?              @map("wallet_id")
  paymentId     String?              @map("payment_id")
  transactionId String?              @map("transaction_id")
  amount        Decimal?             @db.Decimal(14, 2)
  balanceBefore Decimal?             @map("balance_before") @db.Decimal(14, 2)
  balanceAfter  Decimal?             @map("balance_after") @db.Decimal(14, 2)
  remarks       String?              @db.Text
  metadata      Json                 @default("{}")
  createdAt     DateTime             @default(now()) @map("created_at")

  targetUser User  @relation("FinancialAuditTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  actor      User? @relation("FinancialAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([targetUserId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("financial_audit_logs")
}

model WalletBalanceSnapshot {
  id        String   @id @default(cuid())
  walletId  String   @map("wallet_id")
  balance   Decimal  @db.Decimal(14, 2)
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([createdAt])
  @@map("wallet_balance_snapshots")
}

// ─────────────────────────────────────────────────────────────────────────────
// Contact (website inquiries)
// ─────────────────────────────────────────────────────────────────────────────

model ContactInquiry {
  id            String                   @id @default(cuid())
  referenceCode String                   @unique @map("reference_code")
  name          String
  email         String
  phone         String
  company       String?
  subject       ContactSubject
  message       String                   @db.Text
  status        ContactInquiryStatus     @default(NEW)
  priority      ContactInquiryPriority   @default(NORMAL)
  assignedToId  String?                  @map("assigned_to_id")
  resolvedAt    DateTime?                @map("resolved_at")
  resolvedById  String?                  @map("resolved_by_id")
  ipAddress     String?                  @map("ip_address")
  userAgent     String?                  @map("user_agent") @db.Text
  readAt        DateTime?                @map("read_at")
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")

  assignedTo User?                  @relation("ContactInquiryAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolvedBy User?                  @relation("ContactInquiryResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  notes      ContactInquiryNote[]
  activities ContactInquiryActivity[]

  @@index([status])
  @@index([priority])
  @@index([subject])
  @@index([createdAt])
  @@index([email])
  @@index([assignedToId])
  @@map("contact_inquiries")
}

model ContactInquiryNote {
  id        String   @id @default(cuid())
  inquiryId String   @map("inquiry_id")
  authorId  String   @map("author_id")
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  inquiry ContactInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  author  User           @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([inquiryId])
  @@index([authorId])
  @@index([createdAt])
  @@map("contact_inquiry_notes")
}

model ContactInquiryActivity {
  id        String                     @id @default(cuid())
  inquiryId String                     @map("inquiry_id")
  actorId   String?                    @map("actor_id")
  type      ContactInquiryActivityType
  metadata  Json                       @default("{}")
  createdAt DateTime                   @default(now()) @map("created_at")

  inquiry ContactInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  actor   User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([inquiryId])
  @@index([type])
  @@index([createdAt])
  @@map("contact_inquiry_activities")
}

// ─────────────────────────────────────────────────────────────────────────────
// Global sliders (CMS)
// ─────────────────────────────────────────────────────────────────────────────

model SliderSlide {
  id           String      @id @default(cuid())
  sliderKey    String      @default("global") @map("slider_key")
  title        String?
  description  String?     @db.Text
  imageUrl     String      @map("image_url")
  imageKey     String      @map("image_key")
  redirectUrl  String?     @map("redirect_url")
  displayOrder Int         @default(0) @map("display_order")
  status       SlideStatus @default(INACTIVE)
  startDate    DateTime?   @map("start_date")
  endDate      DateTime?   @map("end_date")
  notes        String?     @db.Text
  createdById  String?     @map("created_by_id")
  updatedById  String?     @map("updated_by_id")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  createdBy User? @relation("SliderSlideCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("SliderSlideUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([sliderKey])
  @@index([sliderKey, status])
  @@index([sliderKey, displayOrder])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@map("slider_slides")
}
