  pincode     String  @default("") @map("pincode")
  phone       String  @default("") @map("phone")
  email       String  @default("") @map("email")
  website     String  @default("") @map("website")
  gstin       String  @default("") @map("gstin")
  pan         String  @default("") @map("pan")
  cin         String  @default("") @map("cin")
  bankName    String  @default("") @map("bank_name")
  bankAccount String  @default("") @map("bank_account")
  bankIfsc    String  @default("") @map("bank_ifsc")
  bankBranch  String  @default("") @map("bank_branch")
  terms       String  @default("") @map("terms") @db.Text
  updatedById String? @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation("CompanyProfileUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("company_profile")
}

// =====================================================
// VENDOR COMPLIANCE — dynamic document & question requests from admin
// Flow: Admin creates request → Vendor submits on status page → Admin reviews
// =====================================================

model VendorComplianceRequest {
  id              String                        @id @default(cuid())
  vendorProfileId String                        @map("vendor_profile_id")
  referenceCode   String                        @unique @map("reference_code")
  title           String?
  instructions    String?                       @db.Text
  status          VendorComplianceRequestStatus @default(DRAFT)
  dueAt           DateTime?                     @map("due_at")
  createdById     String                        @map("created_by_id")
  sentAt          DateTime?                     @map("sent_at")
  submittedAt     DateTime?                     @map("submitted_at")
  reviewedAt      DateTime?                     @map("reviewed_at")
  reviewedById    String?                       @map("reviewed_by_id")
  cancelledAt     DateTime?                     @map("cancelled_at")
  createdAt       DateTime                      @default(now()) @map("created_at")
  updatedAt       DateTime                      @updatedAt @map("updated_at")

  vendorProfile VendorProfile                 @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  createdBy     User                          @relation("VendorComplianceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy    User?                         @relation("VendorComplianceReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  items         VendorComplianceRequestItem[]

  @@index([vendorProfileId])
  @@index([status])
  @@index([createdAt])
  @@map("vendor_compliance_requests")
}

model VendorComplianceRequestItem {
  id                String                   @id @default(cuid())
  requestId         String                   @map("request_id")
  itemType          VendorComplianceItemType @map("item_type")
  code              String?
  label             String
  description       String?                  @db.Text
  isRequired        Boolean                  @default(true) @map("is_required")
  sortOrder         Int                      @default(0) @map("sort_order")
  maxFileSizeMb     Int?                     @map("max_file_size_mb")
  acceptedFileTypes Json                     @default("[]") @map("accepted_file_types")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  request   VendorComplianceRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  responses VendorComplianceResponse[]

  @@index([requestId])
  @@index([itemType])
  @@map("vendor_compliance_request_items")
}

model VendorComplianceResponse {
  id              String                         @id @default(cuid())
  requestItemId   String                         @map("request_item_id")
  vendorProfileId String                         @map("vendor_profile_id")
  textAnswer      String?                        @map("text_answer") @db.Text
  fileAssetId     String?                        @map("file_asset_id")
  status          VendorComplianceResponseStatus @default(SUBMITTED)
  adminRemarks    String?                        @map("admin_remarks") @db.Text
  reviewedById    String?                        @map("reviewed_by_id")
  reviewedAt      DateTime?                      @map("reviewed_at")
  submittedAt     DateTime                       @default(now()) @map("submitted_at")
  createdAt       DateTime                       @default(now()) @map("created_at")
  updatedAt       DateTime                       @updatedAt @map("updated_at")

  requestItem   VendorComplianceRequestItem @relation(fields: [requestItemId], references: [id], onDelete: Cascade)
  vendorProfile VendorProfile               @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  fileAsset     FileAsset?                  @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)
  reviewedBy    User?                       @relation("VendorComplianceResponseReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([requestItemId, vendorProfileId])
  @@index([vendorProfileId])
  @@index([fileAssetId])
  @@index([status])
  @@map("vendor_compliance_responses")
}

model AdminNote {
  id              String   @id @default(cuid())
  vendorProfileId String   @map("vendor_profile_id")
  authorId        String   @map("author_id")
  content         String   @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  vendorProfile VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  author        User          @relation("AdminNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([vendorProfileId])
  @@index([authorId])
  @@index([createdAt])
  @@map("admin_notes")
}

model ActivityLog {
  id              String         @id @default(cuid())
  action          ActivityAction
  entityType      String         @map("entity_type")
  entityId        String         @map("entity_id")
  vendorProfileId String?        @map("vendor_profile_id")
  actorId         String?        @map("actor_id")
  metadata        Json           @default("{}")
  ipAddress       String?        @map("ip_address")
  userAgent       String?        @map("user_agent") @db.Text
  createdAt       DateTime       @default(now()) @map("created_at")

  vendorProfile VendorProfile? @relation("VendorActivity", fields: [vendorProfileId], references: [id], onDelete: Cascade)
  actor         User?          @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([vendorProfileId])
  @@index([vendorProfileId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([action])
  @@index([createdAt])
  @@index([actorId, createdAt(sort: Desc)])
  @@map("activity_logs")
}

model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// =====================================================
// PRODUCT ENGINE — PHASE 1 (Printing ERP Foundation)
// Category → ProductFamily → ProductSeries → ProductOffering → ProductOfferingVersion
//
// VERSIONING RULE: All sellable definition (config, pricing, files, workflow, BOM)
// attaches to ProductOfferingVersion — never to ProductOffering directly.
// ProductOffering is the stable catalog identity; versions are immutable snapshots.
// =====================================================

model Category {
  id          String    @id @default(cuid())
  parentId    String?   @map("parent_id")
  name        String
  slug        String    @unique
  description String?   @db.Text
  imageUrl    String?   @map("image_url")
  imageKey    String?   @map("image_key")
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  parent          Category?       @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children        Category[]      @relation("CategoryHierarchy")
  productFamilies ProductFamily[]

  @@index([parentId])
  @@index([isActive, deletedAt])
  @@index([sortOrder])
  @@map("categories")
}

/// Material / substrate under a category — e.g. "800 GSM Cards", "Metal Cards".
model ProductFamily {
  id          String        @id @default(cuid())
  categoryId  String        @map("category_id")
  name        String
  slug        String        @unique
  description String?       @db.Text
  imageUrl    String?       @map("image_url")
  imageKey    String?       @map("image_key")
  sortOrder   Int           @default(0) @map("sort_order")
  status      ProductStatus @default(ACTIVE)
  isActive    Boolean       @default(true) @map("is_active")
  /// Which step-3 screen the vendor order wizard shows after this family is picked. "DEFAULT"
  /// keeps today's behavior (step 3 is skipped). The frontend maps other keys (e.g.
  /// "CATALOG_GALLERY") to a registered template component — an unrecognized key falls back to
  /// "DEFAULT" rather than erroring, so this is safe to leave unset.
  step3TemplateKey String   @default("DEFAULT") @map("step3_template_key")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  category Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  series   ProductSeries[]

  @@index([categoryId])
  @@index([status])
  @@index([isActive, deletedAt])
  @@map("product_families")
}

/// Base finish within a family — e.g. "800 GSM + Matt", "800 GSM + Velvet".
model ProductSeries {
  id             String        @id @default(cuid())
  familyId       String        @map("family_id")
  name           String
  slug           String        @unique
  description    String?       @db.Text
  imageUrl       String?       @map("image_url")
  imageKey       String?       @map("image_key")
  productCode    String?       @unique @map("product_code")
  productionDays Int?          @map("production_days")
  notes          String?       @db.Text
  sortOrder      Int           @default(0) @map("sort_order")
  status         ProductStatus @default(ACTIVE)
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  family    ProductFamily     @relation(fields: [familyId], references: [id], onDelete: Restrict)
  offerings ProductOffering[]

  @@index([familyId])
  @@index([productCode])
  @@index([status])
  @@index([isActive, deletedAt])
  @@map("product_series")
}

/// Sellable finish combination — e.g. "800 GSM + Matt + UV + Foil + Die Cut".
/// Identity and merchandising only; all definition lives on ProductOfferingVersion.
model ProductOffering {
  id               String            @id @default(cuid())
  seriesId         String            @map("series_id")
  name             String
  slug             String            @unique
  shortDescription String?           @map("short_description")
  description      String?           @db.Text
  sku              String?           @unique
  displayName      String?           @map("display_name")
  thumbnailUrl     String?           @map("thumbnail_url")
  thumbnailKey     String?           @map("thumbnail_key")
  visibility       ProductVisibility @default(VENDOR_ONLY)
  sortOrder        Int               @default(0) @map("sort_order")
  status           ProductStatus     @default(DRAFT)
  isFeatured       Boolean           @default(false) @map("is_featured")
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  deletedAt        DateTime?         @map("deleted_at")

  series   ProductSeries            @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  versions ProductOfferingVersion[]
  images   ProductImage[]

  @@index([seriesId])
  @@index([sku])
  @@index([status])
  @@index([visibility])
  @@index([isActive, deletedAt])
  @@map("product_offerings")
}

/// Gallery / marketing images stored in Cloudflare R2
model ProductImage {
  id                String   @id @default(cuid())
  productOfferingId String   @map("product_offering_id")
  imageUrl          String   @map("image_url") @db.Text
  imageKey          String   @map("image_key")
  altText           String?  @map("alt_text")
  sortOrder         Int      @default(0) @map("sort_order")
  isThumbnail       Boolean  @default(false) @map("is_thumbnail")
  createdAt         DateTime @default(now()) @map("created_at")

  productOffering ProductOffering @relation(fields: [productOfferingId], references: [id], onDelete: Cascade)

  @@index([productOfferingId])
  @@index([sortOrder])
  @@map("product_images")
}

/// Immutable versioned snapshot — source of truth for config, pricing, files, workflow, BOM.
/// Quotes, orders, and production jobs must pin a specific version at creation time.
model ProductOfferingVersion {
  id                           String                       @id @default(cuid())
  productOfferingId            String                       @map("product_offering_id")
  versionNumber                Int                          @map("version_number")
  versionLabel                 String                       @map("version_label")
  status                       ProductOfferingVersionStatus @default(DRAFT)
  effectiveFrom                DateTime                     @default(now()) @map("effective_from")
  effectiveTo                  DateTime?                    @map("effective_to")
  isCurrent                    Boolean                      @default(false) @map("is_current")
  changelog                    String?                      @db.Text
  pricingProfileKey            String?                      @map("pricing_profile_key")
  /// Rate for the "flex_area" pricing strategy — price = chargedArea (sq ft) x ratePerSqFt.
  ratePerSqFt                  Decimal?                     @map("rate_per_sq_ft") @db.Decimal(12, 2)
  /// Phase 4 — which flow profile this product follows. Null means the pre-Phase-4 default
  /// (self-serve config wizard); existing products were deliberately not backfilled.
  productTypeProfileId         String?                      @map("product_type_profile_id")
  /// Whole price for the "fixed_catalog" strategy — admin-set, no matrix, no quantity tiers.
  fixedPrice                   Decimal?                     @map("fixed_price") @db.Decimal(12, 2)
  workflowKey                  String?                      @map("workflow_key")
  printProcessId               String?                      @map("print_process_id")
  sizeTemplateId               String?                      @map("size_template_id")
  printSpecificationTemplateId String?                      @map("print_specification_template_id")
  /// Denormalized publish cache — relational models are authoritative.
  configurationSchema          Json                         @default("{}") @map("configuration_schema")
  fileRequirements             Json                         @default("{}") @map("file_requirements")
  metadata                     Json                         @default("{}")
  publishedAt                  DateTime?                    @map("published_at")
  createdAt                    DateTime                     @default(now()) @map("created_at")
  updatedAt                    DateTime                     @updatedAt @map("updated_at")
  deletedAt                    DateTime?                    @map("deleted_at")

  productOffering            ProductOffering             @relation(fields: [productOfferingId], references: [id], onDelete: Restrict)
  productTypeProfile         ProductTypeProfile?         @relation(fields: [productTypeProfileId], references: [id], onDelete: SetNull)
  configurationGroups        ConfigurationGroup[]
  configurationFields        ConfigurationField[]
  configurationRules         ConfigurationRule[]
  quantityPricing            QuantityPricing[]
  pricingRules               PricingRule[]
  priceMatrixCells           PriceMatrixCell[]
  priceModifierRules         PriceModifierRule[]
  rollWidthOptions           RollWidthOption[]
  vendorPriceOverrides       VendorPriceOverride[]
  fileRequirementsRel        FileRequirement[]
  printSpecification         PrintSpecification?
  printSizeStrategy          PrintSizeStrategy?
  artworkRules               ArtworkRule[]
  coveragePricingRules       CoveragePricingRule[]
  printLayers                PrintLayer[]
  artworkFiles               ArtworkFile[]
  printProcess               PrintProcess?               @relation(fields: [printProcessId], references: [id], onDelete: SetNull)
  sizeTemplate               SizeTemplate?               @relation(fields: [sizeTemplateId], references: [id], onDelete: SetNull)
  printSpecificationTemplate PrintSpecificationTemplate? @relation(fields: [printSpecificationTemplateId], references: [id], onDelete: SetNull)
  productPrintConfig         ProductPrintConfig?
  workflow                   ProductOfferingWorkflow?
  bomTemplate                BomTemplate?
  orderItems                 OrderItem[]
  productionOrderItems       ProductionOrderItem[]
  quoteItems                 QuoteItem[]
  qualityChecklistTemplates  QualityChecklistTemplate[]

  @@unique([productOfferingId, versionNumber])
  @@index([productOfferingId, status, deletedAt])
  @@index([productOfferingId, isCurrent])
  @@index([effectiveFrom, effectiveTo])
  @@map("product_offering_versions")
}

// =====================================================
// PRODUCT ENGINE — PHASE 2 (Configuration Engine)
// Dynamic order-time fields, options, and dependency rules per ProductOfferingVersion.
// =====================================================

model ConfigurationGroup {
  id                       String   @id @default(cuid())
  productOfferingVersionId String   @map("product_offering_version_id")
  name                     String
  code                     String
  description              String?  @db.Text
  sortOrder                Int      @default(0) @map("sort_order")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  productOfferingVersion ProductOfferingVersion @relation(fields: [productOfferingVersionId], references: [id], onDelete: Cascade)
  fields                 ConfigurationField[]

  @@unique([productOfferingVersionId, code])
  @@index([productOfferingVersionId])
  @@map("configuration_groups")
}

model ConfigurationField {
  id                       String                 @id @default(cuid())
  productOfferingVersionId String                 @map("product_offering_version_id")
  groupId                  String?                @map("group_id")
  code                     String
  label                    String
  description              String?                @db.Text
  fieldType                ConfigurationFieldType @map("field_type")
  placeholder              String?
  isRequired               Boolean                @default(false) @map("is_required")
  isVisible                Boolean                @default(true) @map("is_visible")
  /// At most one question per version may be primary. Its chosen value stands in for the product
  /// name when a vendor picks what to order — a catalogue that used to be one product per GSM
  /// still reads as "pick a GSM" now that GSM is an option on a single product.
  isPrimary                Boolean                @default(false) @map("is_primary")
  /// Which production steps this field's chosen value matters to — e.g. a "lamination" field
  /// tags WorkflowStepType.LAMINATION. Drives task-detail highlighting: an operator on a
  /// LAMINATION task sees this attribute called out, an operator on DIE_CUTTING doesn't. Purely
  /// data — the highlighting code never hardcodes a field code or department, so a brand new
  /// product or department needs only this column tagged, never a code change.
  relevantStepTypes        WorkflowStepType[]     @default([]) @map("relevant_step_types")
  sortOrder                Int                    @default(0) @map("sort_order")
  createdAt                DateTime               @default(now()) @map("created_at")
  updatedAt                DateTime               @updatedAt @map("updated_at")

  productOfferingVersion ProductOfferingVersion @relation(fields: [productOfferingVersionId], references: [id], onDelete: Cascade)
  group                  ConfigurationGroup?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  options                ConfigurationOption[]
  targetRules            ConfigurationRule[]
  pricingRules           PricingRule[]

  @@unique([productOfferingVersionId, code])
  @@index([productOfferingVersionId])
  @@index([groupId])
  @@map("configuration_fields")
}

model ConfigurationOption {
  id          String   @id @default(cuid())
  fieldId     String   @map("field_id")
  label       String
  value       String
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isDefault   Boolean  @default(false) @map("is_default")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  field        ConfigurationField          @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  pricing      ConfigurationOptionPricing?
  pricingRules PricingRule[]

  @@unique([fieldId, value])
  @@index([fieldId])
  @@map("configuration_options")
}

/// JSON condition engine — supports AND/OR nesting and future custom operators.
/// Example: { "and": [{ "field": "foil", "operator": "!=", "value": "not_required" }] }
model ConfigurationRule {
  id                       String                @id @default(cuid())
  productOfferingVersionId String                @map("product_offering_version_id")
  targetFieldId            String                @map("target_field_id")
  ruleType                 ConfigurationRuleType @map("rule_type")
  condition                Json
  sortOrder                Int                   @default(0) @map("sort_order")
  createdAt                DateTime              @default(now()) @map("created_at")
  updatedAt                DateTime              @updatedAt @map("updated_at")

  productOfferingVersion ProductOfferingVersion @relation(fields: [productOfferingVersionId], references: [id], onDelete: Cascade)
  targetField            ConfigurationField     @relation(fields: [targetFieldId], references: [id], onDelete: Cascade)

  @@index([productOfferingVersionId])
  @@index([targetFieldId])
  @@map("configuration_rules")
}

// =====================================================
// PRODUCT ENGINE — PHASE 3 (Pricing Engine)
// Quantity tiers, option adjustments, advanced rules, and immutable price snapshots.
// =====================================================

model QuantityPricing {
  id                       String   @id @default(cuid())
  productOfferingVersionId String   @map("product_offering_version_id")
  quantity                 Int
  basePrice                Decimal  @map("base_price") @db.Decimal(12, 2)
  isActive                 Boolean  @default(true) @map("is_active")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  productOfferingVersion ProductOfferingVersion @relation(fields: [productOfferingVersionId], references: [id], onDelete: Cascade)

  @@unique([productOfferingVersionId, quantity])
  @@index([productOfferingVersionId])
  @@map("quantity_pricing")
}

model ConfigurationOptionPricing {
  id              String                @id @default(cuid())
  optionId        String                @unique @map("option_id")
  pricingStrategy OptionPricingStrategy @default(FIXED) @map("pricing_strategy")
  adjustmentType  PricingAdjustmentType @map("adjustment_type")
  adjustmentValue Decimal               @map("adjustment_value") @db.Decimal(12, 2)
  /// Strategy-specific parameters (ratePerSqCm, ratePerSheet, formula, boxSize, etc.)
  strategyConfig  Json                  @default("{}") @map("strategy_config")
  isActive        Boolean               @default(true) @map("is_active")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  option        ConfigurationOption                  @relation(fields: [optionId], references: [id], onDelete: Cascade)
  quantityTiers ConfigurationOptionQuantityPricing[]

  @@index([optionId])
  @@map("configuration_option_pricing")
}

/// Quantity-tiered prices for configuration options (e.g. Matt Lamination @ 100/500/1000 qty).
model ConfigurationOptionQuantityPricing {
  id              String   @id @default(cuid())
  optionPricingId String   @map("option_pricing_id")
  quantity        Int
  price           Decimal  @db.Decimal(12, 2)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  optionPricing ConfigurationOptionPricing @relation(fields: [optionPricingId], references: [id], onDelete: Cascade)

  @@unique([optionPricingId, quantity])
  @@index([optionPricingId])
  @@map("configuration_option_quantity_pricing")
}

model PricingRule {
  id                       String                @id @default(cuid())
  productOfferingVersionId String                @map("product_offering_version_id")
  configurationFieldId     String?               @map("configuration_field_id")
  configurationOptionId    String?               @map("configuration_option_id")
  name                     String
  description              String?               @db.Text
  condition                Json                  @default("{}")
  adjustmentType           PricingAdjustmentType @map("adjustment_type")
  adjustmentValue          Decimal               @map("adjustment_value") @db.Decimal(12, 2)
  priority                 Int                   @default(0)
  status                   PricingRuleStatus     @default(ACTIVE)
  createdAt                DateTime              @default(now()) @map("created_at")
  updatedAt                DateTime              @updatedAt @map("updated_at")

  productOfferingVersion ProductOfferingVersion @relation(fields: [productOfferingVersionId], references: [id], onDelete: Cascade)
  configurationField     ConfigurationField?    @relation(fields: [configurationFieldId], references: [id], onDelete: SetNull)
  configurationOption    ConfigurationOption?   @relation(fields: [configurationOptionId], references: [id], onDelete: SetNull)

  @@index([productOfferingVersionId])
  @@index([configurationFieldId])
  @@index([configurationOptionId])
  @@index([status])
  @@index([priority])
  @@map("pricing_rules")
}

// =====================================================
// PRODUCT ENGINE — PHASE 0 PRICING SPINE (Matrix + Roll/Flex + Vendor Overrides)
// One resolver (services/pricing-engine/price-resolver.service.ts) fronts all of this —
// see docs/features/02-phase0-pricing-spine.md.
// =====================================================

/// N-dimensional price cell (e.g. { gsm, sheetSize, qtyBand }) for "matrix" strategy products.
/// dimensionKey is stored as-is for readability/admin display; dimensionKeyHash is the
/// canonical, sorted, stringified form uniqueness and lookups key off — Postgres has no default
/// btree operator class for jsonb, so the raw Json column cannot carry a unique constraint.
model PriceMatrixCell {
  id                       String   @id @default(cuid())
  productOfferingVersionId String   @map("product_offering_version_id")
  dimensionKey             Json     @map("dimension_key")
  dimensionKeyHash         String   @map("dimension_key_hash")
  price                    Decimal? @db.Decimal(12, 2)
  available                Boolean  @default(true)
  unavailableReason        String?  @map("unavailable_reason")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  productOfferingVersion ProductOfferingVersion @relation(fields: [productOfferingVersionId], references: [id], onDelete: Cascade)
  vendorPriceOverrides   VendorPriceOverride[]

  @@unique([productOfferingVersionId, dimensionKeyHash])
  @@index([productOfferingVersionId])
  @@map("price_matrix_cells")
}

/// Conditional surcharge on top of a matrix (or quantity-tier) base price — e.g. B/S surcharge
/// whose amount depends on which GSM is selected. amountTable keys are stringified amountKey values.
model PriceModifierRule {
  id                       String   @id @default(cuid())
  productOfferingVersionId String   @map("product_offering_version_id")
  name                     String
  triggerField             String   @map("trigger_field")
  triggerValue             String   @map("trigger_value")
  amountKey                String   @map("amount_key")
  amountTable              Json     @map("amount_table")
  appliesAfter             String   @default("base") @map("applies_after")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  productOfferingVersion ProductOfferingVersion @relation(fields: [productOfferingVersionId], references: [id], onDelete: Cascade)

  @@index([productOfferingVersionId])
  @@map("price_modifier_rules")
}

/// Fixed set of roll widths (feet) a "flex_area" strategy product can be charged against.
model RollWidthOption {
  id                       String   @id @default(cuid())
  productOfferingVersionId String   @map("product_offering_version_id")
  widthFeet                Decimal  @map("width_feet") @db.Decimal(6, 2)
  isActive                 Boolean  @default(true) @map("is_active")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  productOfferingVersion ProductOfferingVersion @relation(fields: [productOfferingVersionId], references: [id], onDelete: Cascade)

  @@unique([productOfferingVersionId, widthFeet])
  @@index([productOfferingVersionId])
  @@map("roll_width_options")
}

/// Sparse, vendor-specific negotiated price — only the cells/products that actually differ from
/// default get a row here. matrixCellId null = whole-product override (e.g. a flex ratePerSqFt
/// override, or a default-strategy product's base price); set = one specific matrix cell.
/// Uniqueness (one row per vendor+product+cell, and at most one whole-product row per
/// vendor+product) is enforced by partial unique indexes added in the migration SQL, since a
/// plain compound unique constraint does not collapse NULLs in Postgres.
model VendorPriceOverride {
  id                       String                  @id @default(cuid())
  vendorId                 String                  @map("vendor_id")
  productOfferingVersionId String                  @map("product_offering_version_id")
  matrixCellId             String?                 @map("matrix_cell_id")
  overrideType             VendorPriceOverrideType @map("override_type")
  value                    Decimal                 @db.Decimal(12, 2)
  setByUserId              String                  @map("set_by_user_id")
  createdAt                DateTime                @default(now()) @map("created_at")
  updatedAt                DateTime                @updatedAt @map("updated_at")

  vendor                 User                   @relation("VendorPriceOverrideVendor", fields: [vendorId], references: [id], onDelete: Cascade)
  productOfferingVersion ProductOfferingVersion @relation(fields: [productOfferingVersionId], references: [id], onDelete: Cascade)
  matrixCell             PriceMatrixCell?       @relation(fields: [matrixCellId], references: [id], onDelete: Cascade)
  setByUser              User                   @relation("VendorPriceOverrideSetBy", fields: [setByUserId], references: [id], onDelete: Restrict)

  @@index([vendorId, productOfferingVersionId])
  @@index([productOfferingVersionId])
  @@index([matrixCellId])
  @@map("vendor_price_overrides")
}

/// Immutable breakdown stored when an order/quote is priced — protects historical totals.
model PriceSnapshot {
  id              String   @id @default(cuid())
  subtotal        Decimal  @db.Decimal(12, 2)
  adjustmentTotal Decimal  @map("adjustment_total") @db.Decimal(12, 2)
  discountTotal   Decimal  @map("discount_total") @db.Decimal(12, 2)
  taxTotal        Decimal  @map("tax_total") @db.Decimal(12, 2)
  grandTotal      Decimal  @map("grand_total") @db.Decimal(12, 2)
  calculation     Json
  createdAt       DateTime @default(now()) @map("created_at")

  orderItems           OrderItem[]
  productionOrderItems ProductionOrderItem[]
  quoteItems           QuoteItem[]
  amendmentsAsPrevious OrderAmendment[]      @relation("AmendmentPreviousSnapshot")
  amendmentsAsNew      OrderAmendment?       @relation("AmendmentNewSnapshot")

  @@map("price_snapshots")
}

// =====================================================
// PRODUCT ENGINE — PHASE 4 (File Requirement Engine)
// Cloudflare R2 compatible — metadata in DB, blobs in object storage.
// =====================================================

model FileRequirement {
  id                       String              @id @default(cuid())
  productOfferingVersionId String              @map("product_offering_version_id")
  code                     String
  label                    String
  description              String?             @db.Text
  requirementType          FileRequirementType @map("requirement_type")
  maxFileSizeMb            Int?                @map("max_file_size_mb")
  allowMultiple            Boolean             @default(false) @map("allow_multiple")
  /// When set, this slot is only asked for while the condition holds against the vendor's
  /// selections — same JSON shape ConfigurationRule uses, evaluated by the same evaluator.
  /// Null means "always required". This is what lets both-sides printing ask for a second file,
  /// or a UV option add its own slots, without any of those field codes appearing in code.
  condition                Json?
  /// Ordered page list for a slot that takes one multi-page file, each entry optionally
  /// conditional: [{ label: "Front Design File" }, { label: "Back Design File", condition: {...} }].
  /// A both-sides job then asks for a single 2-page PDF instead of a second upload box, and
  /// switching back to single side does not discard what was already uploaded. Null/empty means
  /// a one-page file labelled after the slot.
  pages                    Json?
  /// Heading this slot renders under, so UV layers group away from the design files.
  groupLabel               String?             @map("group_label")
  sortOrder                Int                 @default(0) @map("sort_order")
  createdAt                DateTime            @default(now()) @map("created_at")
  updatedAt                DateTime            @updatedAt @map("updated_at")

  productOfferingVersion ProductOfferingVersion    @relation(fields: [productOfferingVersionId], references: [id], onDelete: Cascade)
  allowedFileTypes       FileRequirementFileType[]
  printLayer             PrintLayer?
  artworkFiles           ArtworkFile[]
  artworkRules           ArtworkRule[]

  @@unique([productOfferingVersionId, code])
  @@index([productOfferingVersionId])
  @@map("file_requirements")
}

model FileRequirementFileType {
  id            String            @id @default(cuid())
  requirementId String            @map("requirement_id")
  fileType      SupportedFileType @map("file_type")

  requirement FileRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([requirementId, fileType])
  @@index([requirementId])
  @@map("file_requirement_file_types")
}

/// File metadata — bytes in Cloudflare R2 (`fileKey`). `fileUrl` is legacy/public only for marketing assets; vendor docs use presigned access.
model FileAsset {
  id           String   @id @default(cuid())
  originalName String   @map("original_name")
  fileName     String   @map("file_name")
  fileKey      String   @unique @map("file_key")
  fileUrl      String   @map("file_url") @db.Text
  mimeType     String   @map("mime_type")
  extension    String
  fileSize     Int      @map("file_size")
  uploadedById String?  @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  uploadedBy              User?                         @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  orderItemFiles          OrderItemFile[]
  complianceResponses     VendorComplianceResponse[]
  artworkFile             ArtworkFile?
  artworkVersions         ArtworkVersion[]
  taskAttachments         WorkflowTaskAttachment[]
  productionNoteFiles     WorkflowTaskProductionNote[]
  qcInspectionAttachments QualityInspectionAttachment[]
  qcDefectAttachments     QualityInspectionDefect[]
  designTaskAttachment    DesignTaskAttachment?

  @@index([uploadedById])
  @@index([createdAt])
  @@map("file_assets")
}

// =====================================================
// PRODUCT ENGINE — PHASE 5 (Workflow Engine)
// Printing ERP production workflow — templates, facilities, SLA.
// =====================================================

model Facility {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String?  @db.Text
  phone     String?
  email     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  departments       Department[]
  workflowTemplates WorkflowTemplate[]
  machines          Machine[]

  @@map("facilities")
}

model Department {
  id          String   @id @default(cuid())
  facilityId  String   @map("facility_id")
  name        String
  code        String   @unique
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  facility              Facility                       @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  workflowSteps         WorkflowTemplateStep[]
  workflowTasks         WorkflowTask[]                 @relation("WorkflowTaskStepDepartment")
  assignedWorkflowTasks WorkflowTask[]                 @relation("WorkflowTaskAssignedDepartment")
  staffAssignments      UserDepartmentAssignment[]
  taskAssignments       WorkflowTaskAssignment[]
  executionSessions     WorkflowTaskExecutionSession[]
  productionNotes       WorkflowTaskProductionNote[]
  machines              Machine[]

  @@index([facilityId])
  @@map("departments")
}

model WorkflowTemplate {
  id          String         @id @default(cuid())
  facilityId  String         @map("facility_id")
  name        String
  code        String         @unique
  description String?        @db.Text
  status      WorkflowStatus @default(ACTIVE)
  isDefault   Boolean        @default(false) @map("is_default")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  facility                 Facility                  @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  steps                    WorkflowTemplateStep[]
  productOfferingWorkflows ProductOfferingWorkflow[]
  workflowInstances        WorkflowInstance[]

  @@index([facilityId])
  @@map("workflow_templates")
}

model WorkflowTemplateStep {
  id                     String           @id @default(cuid())
  workflowTemplateId     String           @map("workflow_template_id")
  departmentId           String           @map("department_id")
  stepName               String           @map("step_name")
  stepCode               String           @map("step_code")
  stepType               WorkflowStepType @map("step_type")
  stepOrder              Int              @map("step_order")
  expectedMinutes        Int              @map("expected_minutes")
  allowRework            Boolean          @default(true) @map("allow_rework")
  allowSkip              Boolean          @default(false) @map("allow_skip")
  isMandatory            Boolean          @default(true) @map("is_mandatory")
  /// Order amendments are blocked once a task for this step has started (left BLOCKED/PENDING/
  /// WAITING/READY/ASSIGNED) — e.g. flag the "Printing" step. Per-template, not a global status list.
  locksAmendmentsOnStart Boolean          @default(false) @map("locks_amendments_on_start")
  /// JSON skip-condition evaluated against the order's configurationSnapshot.selections at workflow
  /// creation time. When the condition matches, the task is created with SKIPPED status so it never
  /// appears in the department queue. Format: { "field": "<configFieldCode>", "operator": "in"|"eq"|"not_in"|"neq", "values": ["v1","v2"] }
  /// Multiple conditions can be AND-ed: [{ ... }, { ... }] — all must match to skip.
  skipWhen               Json?            @map("skip_when")
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")

  workflowTemplate   WorkflowTemplate                 @relation(fields: [workflowTemplateId], references: [id], onDelete: Cascade)
  department         Department                       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  slaPolicy          WorkflowSlaPolicy?
  workflowTasks      WorkflowTask[]
  instructions       String?                          @db.Text
  metadata           Json                             @default("{}")
  checklistTemplates QualityChecklistTemplate[]
  dependencies       WorkflowTemplateStepDependency[] @relation("StepDependsOn")
  dependents         WorkflowTemplateStepDependency[] @relation("StepRequiredBy")

  @@unique([workflowTemplateId, stepOrder])
  @@index([workflowTemplateId])
  @@index([departmentId])
  @@map("workflow_template_steps")
}

model WorkflowTemplateStepDependency {
  id                     String                     @id @default(cuid())
  workflowTemplateStepId String                     @map("workflow_template_step_id")
  dependsOnStepId        String                     @map("depends_on_step_id")
  dependencyType         WorkflowStepDependencyType @default(FINISH_TO_START) @map("dependency_type")
  createdAt              DateTime                   @default(now()) @map("created_at")

  workflowTemplateStep WorkflowTemplateStep @relation("StepDependsOn", fields: [workflowTemplateStepId], references: [id], onDelete: Cascade)
  dependsOnStep        WorkflowTemplateStep @relation("StepRequiredBy", fields: [dependsOnStepId], references: [id], onDelete: Cascade)

  @@unique([workflowTemplateStepId, dependsOnStepId])
  @@index([dependsOnStepId])
  @@map("workflow_template_step_dependencies")
}

/// Links a product offering version to its production workflow template (one per version).
model ProductOfferingWorkflow {
  id                       String   @id @default(cuid())
  productOfferingVersionId String   @unique @map("product_offering_version_id")
  workflowTemplateId       String   @map("workflow_template_id")
  isDefault                Boolean  @default(true) @map("is_default")
  createdAt                DateTime @default(now()) @map("created_at")

  productOfferingVersion ProductOfferingVersion @relation(fields: [productOfferingVersionId], references: [id], onDelete: Cascade)
  workflowTemplate       WorkflowTemplate       @relation(fields: [workflowTemplateId], references: [id], onDelete: Restrict)

  @@index([workflowTemplateId])
  @@map("product_offering_workflows")
}

model Machine {
  id                    String                   @id @default(cuid())
  facilityId            String                   @map("facility_id")
  departmentId          String                   @map("department_id")
  machineCode           String                   @unique @map("machine_code")
  machineName           String                   @map("machine_name")
  machineType           String?                  @map("machine_type")
  manufacturer          String?
  model                 String?
  capabilities          Json                     @default("[]")
  supportedProcesses    Json                     @default("[]") @map("supported_processes")
  minSheetWidthMm       Decimal?                 @map("min_sheet_width_mm") @db.Decimal(10, 2)
  minSheetHeightMm      Decimal?                 @map("min_sheet_height_mm") @db.Decimal(10, 2)
  maxSheetWidthMm       Decimal?                 @map("max_sheet_width_mm") @db.Decimal(10, 2)
  maxSheetHeightMm      Decimal?                 @map("max_sheet_height_mm") @db.Decimal(10, 2)
  maxPrintWidthMm       Decimal?                 @map("max_print_width_mm") @db.Decimal(10, 2)
  maxPrintHeightMm      Decimal?                 @map("max_print_height_mm") @db.Decimal(10, 2)
  speedRating           String?                  @map("speed_rating")
  capacityPerHour       Int?                     @map("capacity_per_hour")
  workingHours          Json                     @default("{}") @map("working_hours")
  averageRuntimeMinutes Int?                     @map("average_runtime_minutes")
  supportedProductIds   Json                     @default("[]") @map("supported_product_ids")
  operationalStatus     MachineOperationalStatus @default(AVAILABLE) @map("operational_status")
  isActive              Boolean                  @default(true) @map("is_active")
  notes                 String?                  @db.Text
  status                MachineStatus            @default(ACTIVE)
  metadata              Json                     @default("{}")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")

  facility           Facility                   @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  department         Department                 @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  assignedTasks      WorkflowTask[]
  taskAssignments    WorkflowTaskAssignment[]
  statusHistory      MachineStatusHistory[]
  maintenanceRecords MachineMaintenanceRecord[]

  @@index([facilityId])
  @@index([departmentId])
  @@index([departmentId, isActive])
  @@index([operationalStatus])
  @@index([isActive, operationalStatus])
  @@index([machineCode])
  @@map("machines")
}

model MachineStatusHistory {
  id             String                    @id @default(cuid())
  machineId      String                    @map("machine_id")
  fromStatus     MachineOperationalStatus? @map("from_status")
  toStatus       MachineOperationalStatus  @map("to_status")
  reason         String?                   @db.Text
  workflowTaskId String?                   @map("workflow_task_id")
  assignmentId   String?                   @map("assignment_id")
  changedById    String?                   @map("changed_by_id")
  createdAt      DateTime                  @default(now()) @map("created_at")

  machine   Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  changedBy User?   @relation("MachineStatusChanger", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([machineId, createdAt(sort: Desc)])
  @@map("machine_status_history")
}

model MachineMaintenanceRecord {
  id            String    @id @default(cuid())
  machineId     String    @map("machine_id")
  title         String
  description   String?   @db.Text
  startedAt     DateTime  @map("started_at")
  endedAt       DateTime? @map("ended_at")
  performedById String?   @map("performed_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")

  machine     Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  performedBy User?   @relation("MachineMaintenancePerformer", fields: [performedById], references: [id], onDelete: SetNull)

  @@index([machineId, startedAt(sort: Desc)])
  @@map("machine_maintenance_records")
}

model WorkflowSlaPolicy {
  id                     String   @id @default(cuid())
  workflowTemplateStepId String   @unique @map("workflow_template_step_id")
  warningAfterMinutes    Int      @map("warning_after_minutes")
  criticalAfterMinutes   Int      @map("critical_after_minutes")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  workflowTemplateStep WorkflowTemplateStep @relation(fields: [workflowTemplateStepId], references: [id], onDelete: Cascade)

  @@map("workflow_sla_policies")
}

// =====================================================
// PRODUCT ENGINE — PHASE 6 (Order + Workflow Execution)
// Production orders, item snapshots, and runtime workflow tasks.
//
// ORDER STRATEGY:
// - ProductionOrder = primary ERP business order (config, pricing, workflow pinned).
// - Order (below) = legacy checkout/wallet layer — retained until unified migration.
// Future: Order.productionOrderId or wallet → ProductionOrder bridge.
// =====================================================

model ProductionOrder {
  id                    String                @id @default(cuid())
  orderNumber           String                @unique @map("order_number")
  /// Null when the order belongs to a RetailCustomer instead — see retailCustomerId. Every order
  /// belongs to exactly one of the two; enforced by a CHECK constraint added in the migration
  /// (Prisma has no declarative XOR constraint).
  customerId            String?               @map("customer_id")
  retailCustomerId      String?               @map("retail_customer_id")
  /// Staff user who placed this order on behalf of the vendor/retail customer; null when the
  /// vendor self-served through the wizard.
  createdByActorId      String?               @map("created_by_actor_id")
  orderName             String?               @map("order_name")
  status                ProductionOrderStatus @default(CONFIRMED)
  subtotal              Decimal               @db.Decimal(12, 2)
  deliveryCharge        Decimal               @default(0) @map("delivery_charge") @db.Decimal(12, 2)
  taxAmount             Decimal               @map("tax_amount") @db.Decimal(12, 2)
  totalAmount           Decimal               @map("total_amount") @db.Decimal(12, 2)
  deliveryRequired      Boolean               @default(false) @map("delivery_required")
  deliveryType          DeliveryType?         @map("delivery_type")
  deliveryAddress       String?               @map("delivery_address") @db.Text
  deliveryStatus        DeliveryStatus?       @map("delivery_status")
  notes                 String?               @db.Text
  quoteId               String?               @map("quote_id")
  walletDeducted        Boolean               @default(false) @map("wallet_deducted")
  estimatedCompletionAt DateTime?             @map("estimated_completion_at")
  sourceDraftId         String?               @map("source_draft_id")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  customer             User?                      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  retailCustomer       RetailCustomer?            @relation(fields: [retailCustomerId], references: [id], onDelete: Restrict)
  createdByActor       User?                      @relation("ProductionOrderCreatedBy", fields: [createdByActorId], references: [id], onDelete: SetNull)
  quote                Quote?                     @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  items                ProductionOrderItem[]
  workflowInstances    WorkflowInstance[]
  jobCards             ProductionJobCard[]
  events               ProductionOrderEvent[]
  walletTransactions   WalletTransaction[]        @relation("ProductionOrderWalletTx")
  cancellationRequests OrderCancellationRequest[]
  amendments           OrderAmendment[]
  dispatchBatchOrder   DispatchBatchOrder?
  designTask           DesignTask?
  paymentReceipts      OrderPaymentReceipt[]

  @@index([customerId])
  @@index([customerId, createdAt(sort: Desc)])
  @@index([retailCustomerId])
  @@index([createdByActorId])
  @@index([status, createdAt(sort: Desc)])
  @@index([quoteId])
  @@index([status])
  @@index([orderNumber])
  @@index([deliveryStatus])
  @@map("production_orders")
}

/// Append-only record of a manually-collected payment against an order — cash/UPI/card taken at
/// the counter or over the phone, recorded by staff rather than processed by the platform. This
/// is deliberately NOT a Payment (that model is Razorpay-specific/online) and NOT a
/// WalletTransaction (that's vendor wallet balance, which this order may not even use — retail
/// orders have no wallet). amountPaid/outstanding/paymentStatus are always derived by summing
/// these rows rather than cached on ProductionOrder, so they can never drift out of sync with the
/// actual payment history — consistent with the platform's other append-only ledgers
/// (FinancialEvent, CreditTransaction).
model OrderPaymentReceipt {
  id            String               @id @default(cuid())
  orderId       String               @map("order_id")
  amount        Decimal              @db.Decimal(12, 2)
  method        PaymentReceiptMethod
  notes         String?              @db.Text
  recordedById  String               @map("recorded_by_id")
  createdAt     DateTime             @default(now()) @map("created_at")

  order      ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  recordedBy User            @relation("OrderPaymentReceiptRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([recordedById])
  @@map("order_payment_receipts")
}

enum PaymentReceiptMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  OTHER
}

/// Walk-in / local customer with no vendor account — created inline by admin/manager during
/// order entry. Deliberately minimal: no wallet, no credit/Udhar concept — that arrives with
/// Phase 2's financial ledger. Looked up by phone so the same customer is reused across orders.
model RetailCustomer {
  id          String   @id @default(cuid())
  name        String
  phone       String
  hasGst      Boolean  @default(false) @map("has_gst")
  gstNumber   String?  @map("gst_number")
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  createdBy       User                @relation("RetailCustomerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  orders          ProductionOrder[]
  dispatchBatches DispatchBatch[]

  @@index([phone])
  @@map("retail_customers")
}

/// Immutable audit record of a config + price change on a placed order. previousSnapshotId /
/// newSnapshotId both point at real, untouched PriceSnapshot rows — amendments are additive,
/// never edits of the original snapshot (non-negotiable #5).
model OrderAmendment {
  id                 String   @id @default(cuid())
  orderId            String   @map("order_id")
  amendedByUserId    String   @map("amended_by_user_id")
  reason             String?  @db.Text
  previousConfig     Json     @map("previous_config")
  newConfig          Json     @map("new_config")
  previousSnapshotId String   @map("previous_snapshot_id")
  newSnapshotId      String   @unique @map("new_snapshot_id")
  /// Full tax-inclusive order-total delta actually settled against the wallet — not just the
  /// pre-tax product-price delta, so the wallet movement and order.totalAmount never drift apart.
  priceDelta         Decimal  @map("price_delta") @db.Decimal(12, 2)
  createdAt          DateTime @default(now()) @map("created_at")

  order            ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amendedBy        User            @relation("OrderAmendmentActor", fields: [amendedByUserId], references: [id], onDelete: Restrict)
  previousSnapshot PriceSnapshot   @relation("AmendmentPreviousSnapshot", fields: [previousSnapshotId], references: [id], onDelete: Restrict)
  newSnapshot      PriceSnapshot   @relation("AmendmentNewSnapshot", fields: [newSnapshotId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt(sort: Desc)])
  @@map("order_amendments")
}

model ProductionOrderItem {
  id                       String   @id @default(cuid())
  orderId                  String   @map("order_id")
  productOfferingVersionId String   @map("product_offering_version_id")
  quantity                 Int
  unitPrice                Decimal  @map("unit_price") @db.Decimal(12, 2)
  totalPrice               Decimal  @map("total_price") @db.Decimal(12, 2)
  priceSnapshotId          String?  @map("price_snapshot_id")
  productSnapshot          Json     @default("{}") @map("product_snapshot")
  configurationSnapshot    Json     @default("{}") @map("configuration_snapshot")
  sizeSnapshot             Json?    @map("size_snapshot")
  validationSnapshot       Json?    @map("validation_snapshot")
  coverageSnapshot         Json?    @map("coverage_snapshot")
  createdAt                DateTime @default(now()) @map("created_at")

  order                  ProductionOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productOfferingVersion ProductOfferingVersion   @relation(fields: [productOfferingVersionId], references: [id], onDelete: Restrict)
  priceSnapshot          PriceSnapshot?           @relation(fields: [priceSnapshotId], references: [id], onDelete: Restrict)
  configurations         OrderItemConfiguration[]
  files                  OrderItemFile[]
  orderArtworks          OrderArtwork[]
  jobCards               ProductionJobCard[]
  workflowInstance       WorkflowInstance?

  @@index([orderId])
  @@index([productOfferingVersionId])
  @@index([priceSnapshotId])
  @@map("production_order_items")
}

/// Immutable timeline for vendor + admin order tracking.
model ProductionOrderEvent {
  id          String   @id @default(cuid())
  orderId     String   @map("order_id")
  eventType   String   @map("event_type")
