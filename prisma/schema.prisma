// Geeta Print ERP - Database Schema
// Scalable relational architecture for enterprise printing operations

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

