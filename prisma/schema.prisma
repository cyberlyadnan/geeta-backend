model VendorCodeSequence {
  id        Int @id @default(1)
  lastValue Int @default(1000) @map("last_value")

  @@map("vendor_code_sequences")
}

/// Single-row, atomically-incrementing catalog version. Every admin write to a catalog-shaping
/// model (product hierarchy, versions, configuration, and — critically — price matrix cells and
/// vendor overrides) bumps this counter, and connected vendor clients revalidate on the change.
///
/// Replaces deriving a version from nine max(updatedAt) aggregates: this is one primary-key read,
/// which matters because every connected client polls it as a fallback when its socket is down.
model CatalogVersion {
  id        Int      @id @default(1)
  version   BigInt   @default(1)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("catalog_versions")
}

/// Sequential production order numbers, one counter per (year, prefix): GP-2026-000001 for
/// vendor/self-serve orders, RC-2026-000001 for local/retail counter orders. Composite key keeps
/// each prefix's sequence independent and race-safe under concurrent creation (same upsert +
/// increment pattern as before — prefix just widens the key instead of changing the mechanism).
model OrderNumberSequence {
  year      Int    @map("year")
  /// Short order-type code, e.g. "GP" (vendor/self-serve), "RC" (retail/local customer).
  prefix    String @default("GP") @map("prefix")
  lastValue Int    @default(0) @map("last_value")

  @@id([year, prefix])
  @@map("order_number_sequences")
}

model VendorProfile {
  id                  String              @id @default(cuid())
  vendorCode          String              @unique @map("vendor_code")
  userId              String              @unique @map("user_id")
  businessName        String              @map("business_name")
  ownerName           String              @map("owner_name")
  alternatePhone      String?             @map("alternate_phone")
  gstNumber           String?             @map("gst_number")
  referenceCode       String?             @map("reference_code")
  employeeCode        String?             @map("employee_code")
  country             String              @default("India")
  state               String?
  district            String?
  city                String?
  pinCode             String              @map("pin_code")
  fullAddress         String              @map("full_address") @db.Text
  businessType        String?             @map("business_type")
  services            Json                @default("[]")
  accountStatus       VendorAccountStatus @default(PENDING) @map("account_status")
  deliveryPreference  DeliveryPreference  @default(ASK_ON_EVERY_ORDER) @map("delivery_preference")
  verificationRemarks String?             @map("verification_remarks") @db.Text
  verifiedAt          DateTime?           @map("verified_at")
  verifiedById        String?             @map("verified_by_id")
  rejectedAt          DateTime?           @map("rejected_at")
  rejectedById        String?             @map("rejected_by_id")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  user                User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy          User?                      @relation("VendorVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  rejectedBy          User?                      @relation("VendorRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  adminNotes          AdminNote[]
  activities          ActivityLog[]              @relation("VendorActivity")
  complianceRequests  VendorComplianceRequest[]
  complianceResponses VendorComplianceResponse[]

  @@index([accountStatus])
  @@index([accountStatus, createdAt(sort: Desc)])
  @@index([deliveryPreference])
  @@index([businessName])
  @@index([vendorCode])
  @@index([createdAt])
  @@map("vendor_profiles")
}

/// Platform-wide delivery configuration (singleton row id = "default")
model DeliverySettings {
  id                    String   @id @default("default")
  defaultDeliveryCharge Decimal  @default(100) @map("default_delivery_charge") @db.Decimal(12, 2)
  isDeliveryEnabled     Boolean  @default(true) @map("is_delivery_enabled")
  isPickupEnabled       Boolean  @default(true) @map("is_pickup_enabled")
  /// Future: zone pricing, courier providers, free-delivery rules, weight tiers
  futureConfig          Json     @default("{}") @map("future_config")
  updatedById           String?  @map("updated_by_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation("DeliverySettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("delivery_settings")
}

