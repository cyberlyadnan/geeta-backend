model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  displayName String   @map("display_name")
  description String?
  permissions Json     @default("[]")
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("roles")
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  passwordHash    String     @map("password_hash")
  firstName       String     @map("first_name")
  lastName        String     @map("last_name")
  phone           String?    @unique
  avatarUrl       String?    @map("avatar_url")
  status          UserStatus @default(PENDING_VERIFICATION)
  roleId          String     @map("role_id")
  lastLoginAt     DateTime?  @map("last_login_at")
  emailVerifiedAt DateTime?  @map("email_verified_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  role                            Role                            @relation(fields: [roleId], references: [id])
  refreshTokens                   RefreshToken[]
  orders                          Order[]
  wallet                          Wallet?
  walletTransactions              WalletTransaction[]
  payments                        Payment[]
  financialAuditsAsTarget         FinancialAuditLog[]             @relation("FinancialAuditTarget")
  financialAuditsAsActor          FinancialAuditLog[]             @relation("FinancialAuditActor")
  walletTransactionsCreated       WalletTransaction[]             @relation("WalletTransactionCreatedBy")
  vendorProfile                   VendorProfile?
  vendorsVerified                 VendorProfile[]                 @relation("VendorVerifiedBy")
  vendorsRejected                 VendorProfile[]                 @relation("VendorRejectedBy")
  adminNotes                      AdminNote[]                     @relation("AdminNoteAuthor")
  activityLogs                    ActivityLog[]                   @relation("ActivityActor")
  sliderSlidesCreated             SliderSlide[]                   @relation("SliderSlideCreatedBy")
  sliderSlidesUpdated             SliderSlide[]                   @relation("SliderSlideUpdatedBy")
  assignedContactInquiries        ContactInquiry[]                @relation("ContactInquiryAssignee")
  resolvedContactInquiries        ContactInquiry[]                @relation("ContactInquiryResolver")
  contactInquiryNotes             ContactInquiryNote[]
  contactInquiryActivities        ContactInquiryActivity[]
  uploadedFileAssets              FileAsset[]
  productionOrders                ProductionOrder[]
  cancellationRequestsSubmitted   OrderCancellationRequest[]      @relation("CancellationRequester")
  cancellationRequestsDecided     OrderCancellationRequest[]      @relation("CancellationDecider")
  vendorOrderDrafts               VendorOrderDraft[]
  userNotifications               UserNotification[]
  productionOrderEvents           ProductionOrderEvent[]          @relation("ProductionOrderEventActor")
  assignedWorkflowTasks           WorkflowTask[]                  @relation("WorkflowTaskAssignee")
  workflowTaskHistory             WorkflowTaskHistory[]           @relation("WorkflowTaskHistoryPerformer")
  reworkRequestsCreated           ReworkRequest[]                 @relation("ReworkRequestCreator")
  qualityInspections              QualityInspection[]             @relation("QualityInspector")
  quotes                          Quote[]
  auditLogs                       AuditLog[]
  vendorComplianceCreated         VendorComplianceRequest[]       @relation("VendorComplianceCreatedBy")
  vendorComplianceReviewed        VendorComplianceRequest[]       @relation("VendorComplianceReviewedBy")
  vendorComplianceItemReviewed    VendorComplianceResponse[]      @relation("VendorComplianceResponseReviewedBy")
  deliverySettingsUpdated         DeliverySettings[]              @relation("DeliverySettingsUpdatedBy")
  companyProfileUpdated           CompanyProfile[]                @relation("CompanyProfileUpdatedBy")
  artworkFiles                    ArtworkFile[]                   @relation("ArtworkFileOwner")
  artworkApprovals                OrderArtwork[]                  @relation("OrderArtworkApprover")
  sheetSizesCreated               SheetSize[]                     @relation("SheetSizeCreatedBy")
  sizeTemplatesCreated            SizeTemplate[]                  @relation("SizeTemplateCreatedBy")
  printProcessesCreated           PrintProcess[]                  @relation("PrintProcessCreatedBy")
  printSpecTemplatesCreated       PrintSpecificationTemplate[]    @relation("PrintSpecTemplateCreatedBy")
  masterArtworkRulesCreated       MasterArtworkRule[]             @relation("MasterArtworkRuleCreatedBy")
  masterValidationRulesCreated    MasterValidationRule[]          @relation("MasterValidationRuleCreatedBy")
  masterCoverageRulesCreated      MasterCoverageRule[]            @relation("MasterCoverageRuleCreatedBy")
  fileUploadRulesCreated          FileUploadRuleTemplate[]        @relation("FileUploadRuleCreatedBy")
  workflowInstancesCreated        WorkflowInstance[]              @relation("WorkflowInstanceCreator")
  workflowTimelineEvents          WorkflowTimelineEvent[]         @relation("WorkflowTimelineActor")
  departmentAssignments           UserDepartmentAssignment[]      @relation("UserDepartmentMember")
  departmentAssignmentsCreated    UserDepartmentAssignment[]      @relation("UserDepartmentAssignedBy")
  taskAssignmentsAsOperator       WorkflowTaskAssignment[]        @relation("TaskAssignmentOperator")
