  createdBy    User                         @relation("ExecutionHoldCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([workflowTaskId, startedAt(sort: Desc)])
  @@index([sessionId])
  @@map("workflow_task_holds")
}

model WorkflowTaskProductionNote {
