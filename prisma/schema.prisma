  assignment   WorkflowTaskAssignment?         @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  operator     User                            @relation("ExecutionSessionOperator", fields: [operatorId], references: [id], onDelete: Restrict)
  department   Department                      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
