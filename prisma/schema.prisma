  inquiry ContactInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  author  User           @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([inquiryId])
  @@index([authorId])
  @@index([createdAt])
  @@map("contact_inquiry_notes")
}

model ContactInquiryActivity {
  id        String                     @id @default(cuid())
  inquiryId String                     @map("inquiry_id")
  actorId   String?                    @map("actor_id")
  type      ContactInquiryActivityType
  metadata  Json                       @default("{}")
  createdAt DateTime                   @default(now()) @map("created_at")

  inquiry ContactInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  actor   User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([inquiryId])
  @@index([type])
  @@index([createdAt])
  @@map("contact_inquiry_activities")
}

// ─────────────────────────────────────────────────────────────────────────────
// Global sliders (CMS)
// ─────────────────────────────────────────────────────────────────────────────

model SliderSlide {
  id           String      @id @default(cuid())
  sliderKey    String      @default("global") @map("slider_key")
  title        String?
  description  String?     @db.Text
  imageUrl     String      @map("image_url")
  imageKey     String      @map("image_key")
  redirectUrl  String?     @map("redirect_url")
  displayOrder Int         @default(0) @map("display_order")
  status       SlideStatus @default(INACTIVE)
  startDate    DateTime?   @map("start_date")
  endDate      DateTime?   @map("end_date")
  notes        String?     @db.Text
