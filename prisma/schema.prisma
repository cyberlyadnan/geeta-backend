// =====================================================
// QUOTATION ENGINE
// Flow: Configure → Quote → Approve → Convert to ProductionOrder
// =====================================================

model Quote {
  id           String      @id @default(cuid())
  quoteNumber  String      @unique @map("quote_number")
  customerId   String      @map("customer_id")
  status       QuoteStatus @default(DRAFT)
  subtotal     Decimal     @db.Decimal(12, 2)
  taxAmount    Decimal     @map("tax_amount") @db.Decimal(12, 2)
  totalAmount  Decimal     @map("total_amount") @db.Decimal(12, 2)
  validityDate DateTime    @map("validity_date")
  notes        String?     @db.Text
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  customer         User              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items            QuoteItem[]
  productionOrders ProductionOrder[]

  @@index([customerId])
  @@index([status])
  @@index([validityDate])
  @@index([quoteNumber])
  @@map("quotes")
}

model QuoteItem {
  id                       String   @id @default(cuid())
  quoteId                  String   @map("quote_id")
  productOfferingVersionId String   @map("product_offering_version_id")
  priceSnapshotId          String?  @map("price_snapshot_id")
  quantity                 Int
  unitPrice                Decimal  @map("unit_price") @db.Decimal(12, 2)
  totalPrice               Decimal  @map("total_price") @db.Decimal(12, 2)
  createdAt                DateTime @default(now()) @map("created_at")

  quote                  Quote                  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productOfferingVersion ProductOfferingVersion @relation(fields: [productOfferingVersionId], references: [id], onDelete: Restrict)
  priceSnapshot          PriceSnapshot?         @relation(fields: [priceSnapshotId], references: [id], onDelete: Restrict)

  @@index([quoteId])
  @@index([productOfferingVersionId])
  @@index([priceSnapshotId])
  @@map("quote_items")
}

// =====================================================
// JOB CARD SYSTEM — shop floor execution unit
// Workers operate from job cards, not raw order records.
// =====================================================

model ProductionJobCard {
  id                     String                  @id @default(cuid())
  jobCardNumber          String                  @unique @map("job_card_number")
  productionOrderId      String                  @map("production_order_id")
  productionOrderItemId  String                  @map("production_order_item_id")
  workflowInstanceId     String                  @map("workflow_instance_id")
  currentStep            Int                     @default(1) @map("current_step")
  status                 ProductionJobCardStatus @default(PENDING)
  qrCode                 String                  @unique @map("qr_code")
  remarks                String?                 @db.Text
  snapshot               Json                    @default("{}")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  productionOrder     ProductionOrder     @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  productionOrderItem ProductionOrderItem @relation(fields: [productionOrderItemId], references: [id], onDelete: Cascade)
  workflowInstance    WorkflowInstance    @relation(fields: [workflowInstanceId], references: [id], onDelete: Restrict)

  @@index([productionOrderId])
  @@index([productionOrderItemId])
  @@index([workflowInstanceId])
  @@index([status])
  @@map("production_job_cards")
}

