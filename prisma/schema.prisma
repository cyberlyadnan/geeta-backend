// Geeta Print ERP - Database Schema
// Scalable relational architecture for enterprise printing operations

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  MANAGER
  STAFF
  CUSTOMER
  VENDOR
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  IN_PRODUCTION
  QUALITY_CHECK
  READY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum WalletTransactionType {
  CREDIT
  DEBIT
  REFUND
  ADJUSTMENT
  HOLD
  RELEASE
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum ContactSubject {
  QUOTE
  ORDER
  PARTNERSHIP
  SUPPORT
  OTHER
}

enum ContactInquiryStatus {
  NEW
  READ
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}

enum VendorAccountStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
  UNDER_REVIEW
  DOCUMENT_REQUIRED
  BLOCKED
}

enum ActivityAction {
  VENDOR_REGISTERED
  VENDOR_STATUS_CHANGED
  VENDOR_VERIFIED
  VENDOR_REJECTED
  VENDOR_SUSPENDED
  ADMIN_NOTE_ADDED
  USER_LOGIN
  USER_LOGIN_BLOCKED
  USER_CREATED
}

enum SlideStatus {
  ACTIVE
  INACTIVE
  SCHEDULED
  EXPIRED
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth & Users
// ─────────────────────────────────────────────────────────────────────────────

model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  displayName String   @map("display_name")
  description String?
  permissions Json     @default("[]")
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("roles")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  firstName    String     @map("first_name")
  lastName     String     @map("last_name")
  phone        String?    @unique
  avatarUrl    String?    @map("avatar_url")
  status       UserStatus @default(PENDING_VERIFICATION)
  roleId       String     @map("role_id")
  lastLoginAt  DateTime?  @map("last_login_at")
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  role               Role               @relation(fields: [roleId], references: [id])
  refreshTokens      RefreshToken[]
  orders             Order[]
  wallet             Wallet?
  walletTransactions WalletTransaction[]
  vendorProfile      VendorProfile?
  vendorsVerified    VendorProfile[]    @relation("VendorVerifiedBy")
  vendorsRejected    VendorProfile[]    @relation("VendorRejectedBy")
  adminNotes         AdminNote[]        @relation("AdminNoteAuthor")
  activityLogs       ActivityLog[]      @relation("ActivityActor")
  sliderSlidesCreated SliderSlide[]     @relation("SliderSlideCreatedBy")
  sliderSlidesUpdated SliderSlide[]     @relation("SliderSlideUpdatedBy")

  @@index([roleId])
  @@index([status])
  @@index([phone])
  @@index([deletedAt])
  @@map("users")
}

model VendorCodeSequence {
  id        Int @id @default(1)
  lastValue Int @default(1000) @map("last_value")

  @@map("vendor_code_sequences")
}

model VendorProfile {
  id                  String              @id @default(cuid())
  vendorCode          String              @unique @map("vendor_code")
  userId              String              @unique @map("user_id")
  businessName        String              @map("business_name")
  ownerName           String              @map("owner_name")
  alternatePhone      String?             @map("alternate_phone")
  gstNumber           String?             @map("gst_number")
  referenceCode       String?             @map("reference_code")
  employeeCode        String?             @map("employee_code")
  country             String              @default("India")
  state               String?
  district            String?
  city                String?
  pinCode             String              @map("pin_code")
  fullAddress         String              @map("full_address") @db.Text
  businessType        String?             @map("business_type")
  services            Json                @default("[]")
  accountStatus       VendorAccountStatus @default(PENDING) @map("account_status")
  verificationRemarks String?             @map("verification_remarks") @db.Text
  verifiedAt          DateTime?           @map("verified_at")
  verifiedById        String?             @map("verified_by_id")
  rejectedAt          DateTime?           @map("rejected_at")
  rejectedById        String?             @map("rejected_by_id")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy User? @relation("VendorVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  rejectedBy User? @relation("VendorRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  adminNotes AdminNote[]
  activities ActivityLog[] @relation("VendorActivity")

  @@index([accountStatus])
  @@index([businessName])
  @@index([vendorCode])
  @@index([createdAt])
  @@map("vendor_profiles")
}

model AdminNote {
  id              String   @id @default(cuid())
  vendorProfileId String   @map("vendor_profile_id")
  authorId        String   @map("author_id")
  content         String   @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  vendorProfile VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  author        User          @relation("AdminNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([vendorProfileId])
  @@index([authorId])
  @@index([createdAt])
  @@map("admin_notes")
}

model ActivityLog {
  id              String         @id @default(cuid())
  action          ActivityAction
  entityType      String         @map("entity_type")
  entityId        String         @map("entity_id")
  vendorProfileId String?        @map("vendor_profile_id")
  actorId         String?        @map("actor_id")
  metadata        Json           @default("{}")
  ipAddress       String?        @map("ip_address")
  userAgent       String?        @map("user_agent") @db.Text
  createdAt       DateTime       @default(now()) @map("created_at")

  vendorProfile VendorProfile? @relation("VendorActivity", fields: [vendorProfileId], references: [id], onDelete: Cascade)
  actor         User?          @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([vendorProfileId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// Catalog
// ─────────────────────────────────────────────────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  parentId    String?  @map("parent_id")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([parentId])
  @@index([isActive])
  @@map("categories")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  sku         String?  @unique
  description String?
  basePrice   Decimal  @map("base_price") @db.Decimal(12, 2)
  categoryId  String   @map("category_id")
  metadata    Json     @default("{}")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  category Category @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([isActive])
  @@map("products")
}

// ─────────────────────────────────────────────────────────────────────────────
// Orders
// ─────────────────────────────────────────────────────────────────────────────

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique @map("order_number")
  userId        String      @map("user_id")
  status        OrderStatus @default(PENDING)
  subtotal      Decimal     @db.Decimal(12, 2)
  taxAmount     Decimal     @default(0) @map("tax_amount") @db.Decimal(12, 2)
  discountAmount Decimal    @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount   Decimal     @map("total_amount") @db.Decimal(12, 2)
  currency      String      @default("INR")
  notes         String?
  metadata      Json        @default("{}")
  placedAt      DateTime?   @map("placed_at")
  completedAt   DateTime?   @map("completed_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  deletedAt     DateTime?   @map("deleted_at")

  user       User        @relation(fields: [userId], references: [id])
  items      OrderItem[]
  walletTransactions WalletTransaction[]

  @@index([userId])
  @@index([status])
  @@index([orderNumber])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String  @map("order_id")
  productId String  @map("product_id")
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  totalPrice Decimal @map("total_price") @db.Decimal(12, 2)
  metadata  Json    @default("{}")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// Wallet
// ─────────────────────────────────────────────────────────────────────────────

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  balance   Decimal  @default(0) @db.Decimal(14, 2)
  currency  String   @default("INR")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id          String                  @id @default(cuid())
  walletId    String                  @map("wallet_id")
  userId      String                  @map("user_id")
  orderId     String?                 @map("order_id")
  type        WalletTransactionType
  status      WalletTransactionStatus @default(PENDING)
  amount      Decimal                 @db.Decimal(14, 2)
  balanceBefore Decimal               @map("balance_before") @db.Decimal(14, 2)
  balanceAfter  Decimal                 @map("balance_after") @db.Decimal(14, 2)
  reference   String?
  description String?
  metadata    Json                    @default("{}")
  createdAt   DateTime                @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  order  Order? @relation(fields: [orderId], references: [id])

  @@index([walletId])
  @@index([userId])
  @@index([orderId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("wallet_transactions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Contact (website inquiries)
// ─────────────────────────────────────────────────────────────────────────────

model ContactInquiry {
  id        String               @id @default(cuid())
  name      String
  email     String
  phone     String
  company   String?
  subject   ContactSubject
  message   String               @db.Text
  status    ContactInquiryStatus @default(NEW)
  ipAddress String?              @map("ip_address")
  userAgent String?              @map("user_agent") @db.Text
  readAt    DateTime?            @map("read_at")
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  @@index([status])
  @@index([subject])
  @@index([createdAt])
  @@index([email])
  @@map("contact_inquiries")
}

// ─────────────────────────────────────────────────────────────────────────────
// Global sliders (CMS)
// ─────────────────────────────────────────────────────────────────────────────

model SliderSlide {
  id           String      @id @default(cuid())
  sliderKey    String      @default("global") @map("slider_key")
  title        String?
  description  String?     @db.Text
  imageUrl     String      @map("image_url")
  imageKey     String      @map("image_key")
  redirectUrl  String?     @map("redirect_url")
  displayOrder Int         @default(0) @map("display_order")
  status       SlideStatus @default(INACTIVE)
  startDate    DateTime?   @map("start_date")
  endDate      DateTime?   @map("end_date")
  notes        String?     @db.Text
  createdById  String?     @map("created_by_id")
  updatedById  String?     @map("updated_by_id")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  createdBy User? @relation("SliderSlideCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("SliderSlideUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([sliderKey])
  @@index([sliderKey, status])
  @@index([sliderKey, displayOrder])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@map("slider_slides")
}
