  previousOperatorId String?                             @map("previous_operator_id")
  priority           WorkflowPriority?                   @map("priority")
  previousPriority   WorkflowPriority?                   @map("previous_priority")
  dueAt              DateTime?                           @map("due_at")
  previousDueAt      DateTime?                           @map("previous_due_at")
  remarks            String?                             @db.Text
  previousRemarks    String?                             @map("previous_remarks") @db.Text
  machineId          String?                             @map("machine_id")
  previousMachineId  String?                             @map("previous_machine_id")
  metadata           Json                                @default("{}")
  performedById      String?                             @map("performed_by_id")
  createdAt          DateTime                            @default(now()) @map("created_at")

  assignment   WorkflowTaskAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  workflowTask WorkflowTask            @relation(fields: [workflowTaskId], references: [id], onDelete: Cascade)
  operator     User?                   @relation("TaskAssignmentHistoryOperator", fields: [operatorId], references: [id], onDelete: SetNull)
  performedBy  User?                   @relation("TaskAssignmentHistoryPerformer", fields: [performedById], references: [id], onDelete: SetNull)

  @@index([workflowTaskId, createdAt(sort: Desc)])
  @@index([assignmentId])
  @@index([performedById])
  @@map("workflow_task_assignment_history")
}

model WorkflowTaskExecutionSession {
  id                      String                             @id @default(cuid())
  workflowTaskId          String                             @map("workflow_task_id")
  assignmentId            String?                            @map("assignment_id")
  operatorId              String                             @map("operator_id")
  departmentId            String                             @map("department_id")
  status                  WorkflowTaskExecutionSessionStatus @default(IN_PROGRESS)
  startedAt               DateTime                           @default(now()) @map("started_at")
  pausedAt                DateTime?                          @map("paused_at")
  resumedAt               DateTime?                          @map("resumed_at")
  completedAt             DateTime?                          @map("completed_at")
  workingDurationSeconds  Int                                @default(0) @map("working_duration_seconds")
  pausedDurationSeconds   Int                                @default(0) @map("paused_duration_seconds")
  holdDurationSeconds     Int                                @default(0) @map("hold_duration_seconds")
  totalDurationSeconds    Int                                @default(0) @map("total_duration_seconds")
  activeIntervalStartedAt DateTime?                          @map("active_interval_started_at")
  activeIntervalType      WorkflowTaskExecutionIntervalType? @map("active_interval_type")
  createdAt               DateTime                           @default(now()) @map("created_at")
  updatedAt               DateTime                           @updatedAt @map("updated_at")

  workflowTask WorkflowTask                   @relation(fields: [workflowTaskId], references: [id], onDelete: Cascade)
  assignment   WorkflowTaskAssignment?          @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  operator     User                           @relation("ExecutionSessionOperator", fields: [operatorId], references: [id], onDelete: Restrict)
  department   Department                     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  intervals    WorkflowTaskExecutionInterval[]
  holds        WorkflowTaskHold[]
  notes        WorkflowTaskProductionNote[]
  attachments  WorkflowTaskAttachment[]
  alerts       WorkflowTaskExecutionAlert[]

  @@index([workflowTaskId, status])
  @@index([operatorId, status])
  @@index([departmentId, status])
  @@index([startedAt(sort: Desc)])
  @@map("workflow_task_execution_sessions")
}

model WorkflowTaskExecutionInterval {
  id              String                            @id @default(cuid())
  sessionId       String                            @map("session_id")
  intervalType    WorkflowTaskExecutionIntervalType @map("interval_type")
  startedAt       DateTime                          @map("started_at")
