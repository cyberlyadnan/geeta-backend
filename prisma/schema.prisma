  history      WorkflowTaskAssignmentHistory[]
  executionSessions WorkflowTaskExecutionSession[]

  @@index([workflowTaskId, status])
  @@index([operatorId, status])
  @@index([departmentId, status])
  @@index([assignedAt(sort: Desc)])
  @@map("workflow_task_assignments")
}

model WorkflowTaskAssignmentHistory {
  id                 String                              @id @default(cuid())
  assignmentId       String?                             @map("assignment_id")
  workflowTaskId     String                              @map("workflow_task_id")
  action             WorkflowTaskAssignmentHistoryAction
