model WorkflowInstance {
  id                      String                 @id @default(cuid())
  orderId                 String                 @map("order_id")
  productionOrderItemId   String                 @unique @map("production_order_item_id")
  workflowTemplateId      String                 @map("workflow_template_id")
  templateVersion         Int                    @default(1) @map("template_version")
  status                  WorkflowInstanceStatus @default(INITIALIZED)
  currentStepOrder        Int                    @default(1) @map("current_step_order")
  startedAt               DateTime?              @map("started_at")
  completedAt             DateTime?              @map("completed_at")
  createdById             String?                @map("created_by_id")
  metadata                Json                   @default("{}")
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")

  order               ProductionOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productionOrderItem ProductionOrderItem    @relation(fields: [productionOrderItemId], references: [id], onDelete: Cascade)
  workflowTemplate    WorkflowTemplate       @relation(fields: [workflowTemplateId], references: [id], onDelete: Restrict)
  createdBy           User?                  @relation("WorkflowInstanceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  tasks               WorkflowTask[]
  jobCards            ProductionJobCard[]
  timelineEvents      WorkflowTimelineEvent[]

  @@index([orderId])
  @@index([workflowTemplateId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("workflow_instances")
}

model WorkflowTask {
  id                     String             @id @default(cuid())
  workflowInstanceId     String             @map("workflow_instance_id")
  workflowTemplateStepId String             @map("workflow_template_step_id")
  departmentId           String             @map("department_id")
  stepOrder              Int                @map("step_order")
  priority               WorkflowPriority   @default(NORMAL)
  estimatedMinutes       Int                @map("estimated_minutes")
  instructions           String?            @db.Text
  metadata               Json               @default("{}")
  assignedToId           String?            @map("assigned_to_id")
  assignedDepartmentId   String?            @map("assigned_department_id")
  assignedMachineId      String?            @map("assigned_machine_id")
  status                 WorkflowTaskStatus @default(BLOCKED)
  queuedAt               DateTime?          @map("queued_at")
  assignedAt             DateTime?          @map("assigned_at")
  startedAt              DateTime?          @map("started_at")
  completedAt            DateTime?          @map("completed_at")
  dueAt                  DateTime?          @map("due_at")
  remarks                String?            @db.Text
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  workflowInstance   WorkflowInstance     @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)
  workflowStep       WorkflowTemplateStep @relation(fields: [workflowTemplateStepId], references: [id], onDelete: Restrict)
  department         Department           @relation("WorkflowTaskStepDepartment", fields: [departmentId], references: [id], onDelete: Restrict)
  assignedTo         User?                @relation("WorkflowTaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedDepartment Department?          @relation("WorkflowTaskAssignedDepartment", fields: [assignedDepartmentId], references: [id], onDelete: SetNull)
  assignedMachine    Machine?             @relation(fields: [assignedMachineId], references: [id], onDelete: SetNull)
  history            WorkflowTaskHistory[]
  reworks            ReworkRequest[]
  slaBreaches        WorkflowSlaBreach[]
  dependencies       WorkflowTaskDependency[] @relation("TaskDependsOn")
  dependents         WorkflowTaskDependency[] @relation("TaskRequiredBy")
  assignments        WorkflowTaskAssignment[]
  assignmentHistory  WorkflowTaskAssignmentHistory[]
  executionSessions  WorkflowTaskExecutionSession[]
  productionNotes    WorkflowTaskProductionNote[]
  attachments        WorkflowTaskAttachment[]
  executionAlerts    WorkflowTaskExecutionAlert[]
  holds              WorkflowTaskHold[]

  @@unique([workflowInstanceId, workflowTemplateStepId])
  @@index([workflowInstanceId])
  @@index([workflowInstanceId, stepOrder])
  @@index([departmentId, status])
  @@index([departmentId, status, priority, dueAt])
  @@index([assignedToId])
  @@index([assignedDepartmentId])
  @@index([assignedMachineId])
  @@index([status])
  @@index([queuedAt])
  @@index([assignedAt])
  @@map("workflow_tasks")
}

model UserDepartmentAssignment {
