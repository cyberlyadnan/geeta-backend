# Application
NODE_ENV=development
APP_NAME=Geeta Print ERP
APP_URL=http://localhost:5000
PORT=5000
API_PREFIX=/api
API_VERSION=v1

# ─── Supabase PostgreSQL (recommended) ───────────────────────────────────────
# Get both URLs from: Supabase Dashboard → Project Settings → Database → Connection string
#
# 1) DATABASE_URL — Connection pooling (Transaction mode), port 6543
#    Used by the running API (Prisma + PgBouncer)
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# 2) DIRECT_URL — Direct connection, port 5432 (Session mode or "Direct connection")
#    Used by Prisma migrations only (prisma migrate)
DIRECT_URL=postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# ─── Local PostgreSQL (alternative) ──────────────────────────────────────────
# DATABASE_URL=postgresql://postgres:password@localhost:5432/geeta_print?schema=public
# DIRECT_URL=postgresql://postgres:password@localhost:5432/geeta_print?schema=public

# Redis
# REDIS_ENABLED=false     # disable Redis completely
# REDIS_OPTIONAL=true     # allow API to start without Redis (dev default)
# REDIS_URL=rediss://default:password@your-upstash-host:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_ACCESS_SECRET=your-access-secret-min-32-chars-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Razorpay — Dashboard → Account & Settings → API Keys
# Use LIVE keys (rzp_live_*) in production; TEST keys (rzp_test_*) for local dev only.
# Wallet recharge uses Dynamic UPI QR API only: POST /v1/payments/qr_codes
# Payment Links, Checkout popup, and Orders API are NOT used.
# image_url from QR API is a short PNG link (e.g. https://rzp.io/i/… or https://rzp.io/rzp/…).
# Webhook URL: https://<your-api-host>/api/v1/payments/webhook
# Webhook events: payment.captured, qr_code.credited, payment.failed, qr_code.closed
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=your_secret_from_razorpay_dashboard
RAZORPAY_WEBHOOK_SECRET=your_webhook_signing_secret

# Wallet recharge limits (INR)
WALLET_MIN_RECHARGE_AMOUNT=100
WALLET_MAX_RECHARGE_AMOUNT=100000
# Razorpay requires ≥15 min; we enforce 20 min minimum in code
WALLET_PAYMENT_EXPIRY_MINUTES=30

# Cloudflare R2 (S3-compatible media storage)
# Bucket CORS must allow PUT from your frontend origin (e.g. http://localhost:3000).
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://your-r2-public-url.r2.dev
# Vendor compliance files are private: served only via short-lived presigned URLs (5 min).
# Keep the R2 bucket private; do not expose vendors/compliance/* on a public bucket policy.
# R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=debug
LOG_DIR=logs

# BullMQ
BULLMQ_PREFIX=geeta-print

# Socket.io
SOCKET_CORS_ORIGIN=http://localhost:3000
