# Application
NODE_ENV=development
APP_NAME=Geeta Print ERP
APP_URL=http://localhost:5000
PORT=5000
API_PREFIX=/api
API_VERSION=v1

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/geeta_print?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=your-access-secret-min-32-chars-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=debug
LOG_DIR=logs

# BullMQ
BULLMQ_PREFIX=geeta-print

# Socket.io
SOCKET_CORS_ORIGIN=http://localhost:3000
