{
  "name": "geeta-print-backend",
  "version": "1.0.0",
  "description": "Enterprise Printing ERP & Workflow Management Platform API",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "dotenv -e .env -e .env.local -- tsx src/workers/index.ts",
    "dev:nodemon": "nodemon",
    "build": "prisma generate && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/workers/index.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"prisma/**/*.prisma\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "tsx --test src/modules/workflow/__tests__/**/*.test.ts",
    "test:workflow": "tsx --test src/modules/workflow/__tests__/**/*.test.ts",
    "prisma:generate": "dotenv -e .env -e .env.local -- prisma generate",
    "prisma:migrate": "dotenv -e .env -e .env.local -- prisma migrate dev",
    "prisma:migrate:deploy": "dotenv -e .env -e .env.local -- prisma migrate deploy",
    "prisma:studio": "dotenv -e .env -e .env.local -- prisma studio",
    "prisma:seed": "dotenv -e .env -e .env.local -- tsx prisma/seed/run.ts",
    "seed": "dotenv -e .env -e .env.local -- tsx prisma/seed/run.ts",
    "seed:master": "dotenv -e .env -e .env.local -- tsx prisma/seed/run.ts --only=master",
    "seed:products": "dotenv -e .env -e .env.local -- tsx prisma/seed/run.ts --only=products",
    "seed:pricing": "dotenv -e .env -e .env.local -- tsx prisma/seed/run.ts --only=pricing",
    "perf:api": "dotenv -e .env -e .env.local -- tsx scripts/perf/api-probe.ts",
    "perf:network": "dotenv -e .env -e .env.local -- tsx scripts/perf/network-benchmark.ts",
    "perf:explain": "dotenv -e .env -e .env.local -- tsx scripts/perf/explain-analyze.ts",
    "db:perf-indexes": "prisma db execute --file=scripts/perf/add-performance-indexes.sql --schema=prisma/schema.prisma",
    "db:security-lockdown": "dotenv -e .env -e .env.local -- prisma db execute --file scripts/supabase-rls-lockdown.sql --schema prisma/schema.prisma",
    "r2:configure-cors": "dotenv -e .env -e .env.local -- tsx scripts/configure-r2-cors.ts",
    "postinstall": "prisma generate"
  },
  "keywords": [
    "erp",
    "printing",
    "workflow",
    "express",
    "typescript"
  ],
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1056.0",
    "@aws-sdk/s3-request-presigner": "^3.1056.0",
    "@prisma/client": "^6.8.2",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.53.2",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "pdf-lib": "^1.17.1",
    "razorpay": "^2.9.6",
    "sharp": "^0.35.2",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.25.42"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.15.21",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "nodemon": "^3.1.10",
    "prettier": "^3.5.3",
    "prisma": "^6.8.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1"
  }
}
